<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <DefaultRid>win-x64</DefaultRid>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <StaticAppHostPackageVersion>1.0.0-dev</StaticAppHostPackageVersion>
    <AvaloniaAppHostPackageVersion>11.0.0-preview.1</AvaloniaAppHostPackageVersion>
    <AvaloniaVersion>11.3.12</AvaloniaVersion>

    <PackagesOutputRoot>$(RepoRoot)artifacts\packages</PackagesOutputRoot>
    <StaticAppHostPackageOutputDir>$(PackagesOutputRoot)\$(Configuration)</StaticAppHostPackageOutputDir>
    <AvaloniaAppHostPackageOutputDir>$(PackagesOutputRoot)\$(Configuration)</AvaloniaAppHostPackageOutputDir>

    <HostLibsRoot>$(RepoRoot)artifacts\hostlibs</HostLibsRoot>
    <AvaloniaNativeLibsRoot>$(RepoRoot)artifacts\skiasharp-2.88.9</AvaloniaNativeLibsRoot>
  </PropertyGroup>
</Project>
