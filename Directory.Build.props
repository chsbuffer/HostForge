<Project>

  <PropertyGroup>
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
    <AngleVersion>2.1.27548.20260419</AngleVersion>
    <SkiaSharpVersion Condition="'$(SkiaSharpVersion)' == ''">3.119.4</SkiaSharpVersion>
    <HarfBuzzVersion Condition="'$(HarfBuzzVersion)' == '' and '$(SkiaSharpVersion)' == '3.119.4'">8.3.1.5</HarfBuzzVersion>
    <HarfBuzzVersion Condition="'$(HarfBuzzVersion)' == '' and '$(SkiaSharpVersion)' == '4.153.1'">14.2.1.301</HarfBuzzVersion>
    <AvaloniaNativeVersion Condition="'$(AvaloniaNativeVersion)' == ''">12.1.4</AvaloniaNativeVersion>
    <HostLibsVersion>10.0.13</HostLibsVersion>
  </PropertyGroup>

  <!-- Increment only the affected native version line when publishing a fix. -->
  <PropertyGroup>
    <SkiaSharpPackageVersion Condition="$(SkiaSharpVersion.StartsWith('3.'))">$(SkiaSharpVersion).1</SkiaSharpPackageVersion>
    <SkiaSharpPackageVersion Condition="$(SkiaSharpVersion.StartsWith('4.'))">$(SkiaSharpVersion).1</SkiaSharpPackageVersion>
    <AnglePackageVersion>$([System.Version]::Parse('$(AngleVersion)').ToString(3)).1</AnglePackageVersion>
    <AvaloniaNativePackageVersion>$(AvaloniaNativeVersion).1</AvaloniaNativePackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetAvaloniaVersion>12.0</TargetAvaloniaVersion>
    <_Major>1</_Major>
    <_Preview Condition="'$(_Preview)' == ''"></_Preview>

    <_AvaloniaAppHostPreview>$(_Preview)</_AvaloniaAppHostPreview>
    <_AvaloniaAppHostPreview Condition="$(SkiaSharpVersion.StartsWith('4.')) and '$(_Preview)' == ''">skia4</_AvaloniaAppHostPreview>
    <_AvaloniaAppHostPreview Condition="$(SkiaSharpVersion.StartsWith('4.')) and '$(_Preview)' != ''">$(_Preview).skia4</_AvaloniaAppHostPreview>

    <AvaloniaAppHostPackageVersion>$(TargetAvaloniaVersion).$(_Major)</AvaloniaAppHostPackageVersion>
    <AvaloniaAppHostPackageVersion Condition="'$(_AvaloniaAppHostPreview)' != ''">$(AvaloniaAppHostPackageVersion)-$(_AvaloniaAppHostPreview)</AvaloniaAppHostPackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <HostLibsFlavor Condition="'$(HostLibsFlavor)' == ''">default</HostLibsFlavor>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <PackagesOutputRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/packages'))</PackagesOutputRoot>
    <AvaloniaAppHostPackageOutputDir>$([MSBuild]::NormalizePath('$(PackagesOutputRoot)', '$(Configuration)'))</AvaloniaAppHostPackageOutputDir>

    <HostLibsBaseRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/hostlibs/$(HostLibsVersion)'))</HostLibsBaseRoot>
    <HostLibsRoot>$([MSBuild]::NormalizePath('$(HostLibsBaseRoot)', '$(HostLibsFlavor)'))</HostLibsRoot>
    <AvaloniaNativeLibsRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/skiasharp/$(SkiaSharpVersion)'))</AvaloniaNativeLibsRoot>
    <AngleNativeLibsRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/angle/$(AngleVersion)'))</AngleNativeLibsRoot>
  </PropertyGroup>

</Project>
