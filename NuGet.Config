<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="artifacts/tmp/nuget/packages" />
  </config>
  <!--
    ChsBuffer.* packages come only from the packages built in this repository: a missing local package fails the
    restore instead of resolving the published package of the same version from nuget.org.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="hostforge" value="artifacts/packages/Release" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="hostforge">
      <package pattern="ChsBuffer.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
