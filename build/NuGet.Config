<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The upstream sources that the recipes build under build/conan (the .NET Runtime, Avalonia) restore from the
    sources their own configuration and the machine configure. NuGet merges every NuGet.Config above a project, so
    this file lifts the repository's mapping, which would otherwise allow nuget.org only.
  -->
  <disabledPackageSources>
    <add key="hostforge" value="true" />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
