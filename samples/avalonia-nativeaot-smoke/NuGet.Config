<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The smoke publishes any static package version, published or local, so SmokePackageSource and the configured
    sources supply ChsBuffer.* here instead of only the repository's package directory.
  -->
  <disabledPackageSources>
    <add key="hostforge" value="true" />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
