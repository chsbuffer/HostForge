<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target the runtime whose host libs are relinked: -p:HostLibsTargetFramework=net11.0 (also seen by restore). -->
    <TargetFramework>$(HostLibsTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <RidOrDefault>$(RuntimeIdentifier)</RidOrDefault>
    <RidOrDefault Condition="'$(RidOrDefault)' == ''">$(DefaultAppHostRuntimeIdentifier)</RidOrDefault>
    <HostLibsFlavor Condition="'$(RidOrDefault)' != '' and $(RidOrDefault.StartsWith('win'))">default</HostLibsFlavor>
    <HostLibsRoot>$([MSBuild]::NormalizePath('$(HostLibsBaseRoot)', '$(HostLibsFlavor)'))</HostLibsRoot>
    <StaticHostAssetsBaseDir>$(HostLibsRoot)</StaticHostAssetsBaseDir>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\src\StaticAppHost.targets" />

  <ItemGroup>
    <NativeLibrary Include="$(MSBuildProjectDirectory)\NativeLib\dll.lib" Condition="$(RidOrDefault.StartsWith('win'))">
      <WholeArchive>true</WholeArchive>
    </NativeLibrary>
    <NativeLibrary Include="$(MSBuildProjectDirectory)\NativeLib\dll.a" Condition="!$(RidOrDefault.StartsWith('win'))">
      <WholeArchive>true</WholeArchive>
    </NativeLibrary>
  </ItemGroup>

  <!-- Unix systems may install Python only as python3 (PEP 394). -->
  <Target Name="BuildNativeLib" BeforeTargets="CoreCompile">
    <Exec Command="python build.py"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          WorkingDirectory="$(ProjectDir)NativeLib" />
    <Exec Command="python3 build.py"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          WorkingDirectory="$(ProjectDir)NativeLib" />
  </Target>

</Project>
