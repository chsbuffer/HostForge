<Project>
  <PropertyGroup>
    <CppLinker>link</CppLinker>
    <_FindVcVarsAllPath>$(MSBuildThisFileDirectory)findvcvarsall.bat</_FindVcVarsAllPath>
  </PropertyGroup>

  <ItemGroup>
    <StaticHostWindowsRid Include="win-x64">
      <Machine>X64</Machine>
      <VcVarsArch>x64</VcVarsArch>
    </StaticHostWindowsRid>

    <StaticHostWindowsRid Include="win-arm64">
      <Machine>ARM64</Machine>
      <VcVarsArch>arm64</VcVarsArch>
    </StaticHostWindowsRid>
  </ItemGroup>

  <Target Name="SetupOSSpecificProps">
    <ItemGroup>
      <_NativeLibraryInput Include="@(NativeLibrary)">
        <WholeArchive Condition="'%(NativeLibrary.WholeArchive)' == ''">false</WholeArchive>
      </_NativeLibraryInput>

      <_StaticHostWindowsRid Include="@(StaticHostWindowsRid)"
                                     Condition="'%(Identity)' == '$(StaticHostRid)'" />
    </ItemGroup>

    <PropertyGroup>
      <_StaticHostLinkMachine>%(_StaticHostWindowsRid.Machine)</_StaticHostLinkMachine>
      <_StaticHostVcVarsArch>%(_StaticHostWindowsRid.VcVarsArch)</_StaticHostVcVarsArch>
    </PropertyGroup>

    <!--
      Harden and delay-load like the runtime's own host links, which the host libs record: /guard:cf, plus
      /guard:ehcont and /CETCOMPAT on x64; .NET 10's singlefilehost also delay-loads WinRT and version.dll with
      delayimp.lib, .NET 11 links neither. Host libs without these records get the flags of .NET 10.
    -->
    <ReadLinesFromFile File="$(StaticHostAssetsDir)\apphost.linkflags"
                       Condition="Exists('$(StaticHostAssetsDir)\apphost.linkflags')">
      <Output TaskParameter="Lines" ItemName="_AppHostRecordedLinkFlags" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(StaticHostAssetsDir)\singlefilehost.linkflags"
                       Condition="Exists('$(StaticHostAssetsDir)\singlefilehost.linkflags')">
      <Output TaskParameter="Lines" ItemName="_SingleFileHostRecordedLinkFlags" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_StaticHostRecordedLinkFlagPattern>(?i)\s*(?:([/-](?:guard:|CETCOMPAT|DELAYLOAD:)\S*)|\S+)</_StaticHostRecordedLinkFlagPattern>
      <_StaticHostDefaultHardeningFlags>/guard:cf</_StaticHostDefaultHardeningFlags>
      <_StaticHostDefaultHardeningFlags Condition="'$(_StaticHostLinkMachine)' == 'X64'">/guard:cf /guard:ehcont /CETCOMPAT</_StaticHostDefaultHardeningFlags>

      <_AppHostRecordedLinkFlagsText>@(_AppHostRecordedLinkFlags, ' ')</_AppHostRecordedLinkFlagsText>
      <_AppHostUpstreamLinkFlags>$([System.Text.RegularExpressions.Regex]::Replace('$(_AppHostRecordedLinkFlagsText)', '$(_StaticHostRecordedLinkFlagPattern)', '$1 ').Trim())</_AppHostUpstreamLinkFlags>
      <_AppHostUpstreamLinkFlags Condition="'@(_AppHostRecordedLinkFlags)' == ''">$(_StaticHostDefaultHardeningFlags)</_AppHostUpstreamLinkFlags>

      <_SingleFileHostRecordedLinkFlagsText>@(_SingleFileHostRecordedLinkFlags, ' ')</_SingleFileHostRecordedLinkFlagsText>
      <_SingleFileHostUpstreamLinkFlags>$([System.Text.RegularExpressions.Regex]::Replace('$(_SingleFileHostRecordedLinkFlagsText)', '$(_StaticHostRecordedLinkFlagPattern)', '$1 ').Trim())</_SingleFileHostUpstreamLinkFlags>
      <_SingleFileHostUpstreamLinkFlags Condition="'@(_SingleFileHostRecordedLinkFlags)' == ''">$(_StaticHostDefaultHardeningFlags) /DELAYLOAD:api-ms-win-core-winrt-l1-1-0.dll /DELAYLOAD:version.dll</_SingleFileHostUpstreamLinkFlags>
    </PropertyGroup>

    <!--
      With /guard:ehcont, link.exe fails with LNK1386 on any object that has C++ EH but was compiled without
      /guard:ehcont. StaticHostGuardEHCont=false links such libraries without the EH continuation table.
      /force:guardehcont is not used: it leaves their continuation targets out of the table, so a process
      with enforced CET shadow stacks terminates when an exception is caught in them.
    -->
    <PropertyGroup Condition="'$(StaticHostGuardEHCont)' == 'false'">
      <_AppHostUpstreamLinkFlags>$([System.Text.RegularExpressions.Regex]::Replace('$(_AppHostUpstreamLinkFlags)', '(?i)[/-]guard:ehcont\S*', ''))</_AppHostUpstreamLinkFlags>
      <_SingleFileHostUpstreamLinkFlags>$([System.Text.RegularExpressions.Regex]::Replace('$(_SingleFileHostUpstreamLinkFlags)', '(?i)[/-]guard:ehcont\S*', ''))</_SingleFileHostUpstreamLinkFlags>
    </PropertyGroup>

    <PropertyGroup>
      <_AppHostLinkFlags>/DEPENDENTLOADFLAG:0x800 /DEBUG /DEBUGTYPE:CV,FIXUP /PDBCOMPRESS /STACK:0x180000 /MANIFEST:NO /INCREMENTAL:NO /OPT:REF /OPT:ICF /NODEFAULTLIB:libucrt.lib /DEFAULTLIB:ucrt.lib /subsystem:console $(_AppHostUpstreamLinkFlags) /LTCG </_AppHostLinkFlags>
      <_SingleFileHostLinkFlags>/DEPENDENTLOADFLAG:0x800 /DEBUG /DEBUGTYPE:CV,FIXUP /PDBCOMPRESS /STACK:0x180000 /MANIFEST:NO /INCREMENTAL:NO /OPT:REF /OPT:ICF /NODEFAULTLIB:libucrt.lib /DEFAULTLIB:ucrt.lib /subsystem:console $(_SingleFileHostUpstreamLinkFlags) /LTCG </_SingleFileHostLinkFlags>
    </PropertyGroup>

    <Error Condition="'$(_StaticHostLinkMachine)' == ''"
           Text="Cannot resolve linker machine for RID '$(StaticHostRid)' from StaticHostWindowsRid." />
    <Error Condition="'$(_StaticHostVcVarsArch)' == ''"
           Text="Cannot resolve vcvars architecture for RID '$(StaticHostRid)' from StaticHostWindowsRid." />

    <Exec Command="&quot;$(_FindVcVarsAllPath)&quot; $(_StaticHostVcVarsArch)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FindVCVarsallOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_VCVarsAllFound" />
    </Exec>

    <ItemGroup Condition="'$(_VCVarsAllFound)' == '0'">
      <AdditionalNativeLibraryDirectories Include="$(_FindVCVarsallOutput.Split(`#`)[1].Split(';'))" />
    </ItemGroup>

    <!--
      link.exe honors only the last /DEF, so a module definition passed through LinkerArg (such as ANGLE's
      exports) would replace singlefilehost's own exports, or the other way round. Merge the EXPORTS of all
      module definitions into one generated file per host instead. Inputs must contain only EXPORTS sections.
    -->
    <ItemGroup>
      <_StaticHostModuleDefinitionArg Include="@(LinkerArg)"
                                      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)^[/-]DEF:'))">
        <DefFile>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '(?i)^[/-]DEF:"?([^"]*)"?$', '$1'))</DefFile>
      </_StaticHostModuleDefinitionArg>
      <_AppHostModuleDefinition Include="@(_StaticHostModuleDefinitionArg->'%(DefFile)')" />
      <_SingleFileHostModuleDefinition Include="$(StaticHostAssetsDir)\singlefilehost.def" />
      <_SingleFileHostModuleDefinition Include="@(_AppHostModuleDefinition)" />
    </ItemGroup>

    <PropertyGroup>
      <_AppHostModuleDefinitionFile>$([System.IO.Path]::ChangeExtension('$(AppHostLinkFullPath)', '.def'))</_AppHostModuleDefinitionFile>
      <_SingleFileHostModuleDefinitionFile>$([System.IO.Path]::ChangeExtension('$(SingleFileHostLinkFullPath)', '.def'))</_SingleFileHostModuleDefinitionFile>
    </PropertyGroup>

    <ReadLinesFromFile File="%(_AppHostModuleDefinition.FullPath)" Condition="'@(_AppHostModuleDefinition)' != ''">
      <Output TaskParameter="Lines" ItemName="_AppHostModuleDefinitionLine" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="%(_SingleFileHostModuleDefinition.FullPath)">
      <Output TaskParameter="Lines" ItemName="_SingleFileHostModuleDefinitionLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_AppHostModuleDefinitionLine Remove="@(_AppHostModuleDefinitionLine)"
                                    Condition="'$([System.String]::Copy(`%(Identity)`).Trim().ToUpperInvariant())' == 'EXPORTS'" />
      <_SingleFileHostModuleDefinitionLine Remove="@(_SingleFileHostModuleDefinitionLine)"
                                           Condition="'$([System.String]::Copy(`%(Identity)`).Trim().ToUpperInvariant())' == 'EXPORTS'" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(AppHostLinkFullPath)'));$([System.IO.Path]::GetDirectoryName('$(SingleFileHostLinkFullPath)'))" />
    <WriteLinesToFile File="$(_AppHostModuleDefinitionFile)"
                      Lines="EXPORTS;@(_AppHostModuleDefinitionLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'@(_AppHostModuleDefinition)' != ''" />
    <WriteLinesToFile File="$(_SingleFileHostModuleDefinitionFile)"
                      Lines="EXPORTS;@(_SingleFileHostModuleDefinitionLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_CommonLinkerArg Include="/machine:$(_StaticHostLinkMachine)" />
      <_CommonLinkerArg Include="@(AdditionalNativeLibraryDirectories->'/LIBPATH:&quot;%(Identity)&quot;')" />
      <_CommonLinkerArg Include="@(LinkerArg)"
                        Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '(?i)^[/-]DEF:'))" />

      <_WholeArchiveNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' == 'true'" />
      <_DefaultNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' != 'true'" />

      <_AppHostLinkerArg Include="@(_CommonLinkerArg)" />
      <_AppHostLinkerArg Include="$(_AppHostLinkFlags)" />
      <_AppHostLinkerArg Include="/DEF:&quot;$(_AppHostModuleDefinitionFile)&quot;" Condition="'@(_AppHostModuleDefinition)' != ''" />
      <_AppHostLinkerArg Include="@apphost.rsp" />
      <_AppHostLinkerArg Include="@(_WholeArchiveNativeLib->'/wholearchive:&quot;%(FullPath)&quot;')" />
      <_AppHostLinkerArg Include="@(_DefaultNativeLib->'&quot;%(FullPath)&quot;')" />
      <_AppHostLinkerArg Include="/out:&quot;$(AppHostLinkFullPath)&quot;" />

      <_SingleFileHostLinkerArg Include="@(_CommonLinkerArg)" />
      <_SingleFileHostLinkerArg Include="$(_SingleFileHostLinkFlags)" />
      <_SingleFileHostLinkerArg Include="/DEF:&quot;$(_SingleFileHostModuleDefinitionFile)&quot;" />
      <_SingleFileHostLinkerArg Include="@singlefilehost.rsp" />
      <_SingleFileHostLinkerArg Include="@(_WholeArchiveNativeLib->'/wholearchive:&quot;%(FullPath)&quot;')" />
      <_SingleFileHostLinkerArg Include="@(_DefaultNativeLib->'&quot;%(FullPath)&quot;')" />
      <_SingleFileHostLinkerArg Include="/out:&quot;$(SingleFileHostLinkFullPath)&quot;" />
    </ItemGroup>

    <PropertyGroup Condition="'$(_VCVarsAllFound)' == '0'">
      <_CppToolsDirectory>$(_FindVCVarsallOutput.Split(`#`)[0])</_CppToolsDirectory>
      <CppLinker>$(_CppToolsDirectory)link.exe</CppLinker>
    </PropertyGroup>

    <Error Condition="'$(_VCVarsAllFound)' == '1'"
           Text="[StaticAppHost] MSVC toolchain not found. Install Desktop development with C++ workload (and ARM64 build tools when needed)." />
  </Target>
</Project>
