<Project>

  <Import Project="$(MSBuildThisFileDirectory)StaticAppHost.props" />
  <Import Project="$(MSBuildThisFileDirectory)StaticAppHost.Windows.targets" Condition="'$(_targetOS)' == 'win'" />
  <Import Project="$(MSBuildThisFileDirectory)StaticAppHost.Unix.targets" Condition="'$(_targetOS)' != 'win'" />

  <Target Name="_GenerateHostFingerprint"
          DependsOnTargets="SetupOSSpecificProps">

    <ItemGroup>
      <_AppHostFingerprintFile Include="$(_AppHostRspPath)" />
      <_SingleFileHostFingerprintFile Include="$(_SingleFileHostRspPath)" />

      <_HostVariant Include="AppHost">
        <StampPath>$(AppHostStampFullPath)</StampPath>
        <CommandText>@(_AppHostLinkerArg, '&#x0A;')</CommandText>
        <FilesText>@(_AppHostFingerprintFile->'%(FullPath)|%(ModifiedTime)', '&#x0A;')&#x0A;@(_NativeLibraryInput->'%(FullPath)|%(ModifiedTime)', '&#x0A;')&#x0A;@(LinkerInput->'%(FullPath)|%(ModifiedTime)', '&#x0A;')</FilesText>
      </_HostVariant>

      <_HostVariant Include="SingleFileHost">
        <StampPath>$(SingleFileHostStampFullPath)</StampPath>
        <CommandText>@(_SingleFileHostLinkerArg, '&#x0A;')</CommandText>
        <FilesText>@(_SingleFileHostFingerprintFile->'%(FullPath)|%(ModifiedTime)', '&#x0A;')&#x0A;@(_NativeLibraryInput->'%(FullPath)|%(ModifiedTime)', '&#x0A;')&#x0A;@(LinkerInput->'%(FullPath)|%(ModifiedTime)', '&#x0A;')</FilesText>
      </_HostVariant>
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(_HostVariant.StampPath)'))" />
    <WriteLinesToFile File="%(_HostVariant.StampPath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="Variant=%(_HostVariant.Identity)&#x0A;Rid=$(StaticHostRid)&#x0A;CppLinker=$(CppLinker)&#x0A;Command&#x0A;%(_HostVariant.CommandText)&#x0A;Files&#x0A;%(_HostVariant.FilesText)" />
  </Target>

  <Target Name="LinkAppHost"
          BeforeTargets="_CreateAppHost;_CreateAppHostForPublish"
          DependsOnTargets="_GenerateHostFingerprint"
          Inputs="$(AppHostStampFullPath)"
          Outputs="$(AppHostLinkFullPath)"
          Condition="'@(NativeLibrary)' != '' and ('$(ComputeNETCoreBuildOutputFiles)' == 'true' or '$(_UpdateAppHostForPublish)' == 'true')">

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(AppHostLinkFullPath)'))" />
    <Message Importance="high"
             Text="[HostForge.StaticAppHost] LinkAppHost executed for $(StaticHostRid): $(AppHostLinkFullPath)" />
    <Exec Command="&quot;$(CppLinker)&quot; @(_AppHostLinkerArg, ' ')"
          WorkingDirectory="$(StaticHostAssetsDir)" />

    <PropertyGroup>
      <AppHostSourcePath>$(AppHostLinkFullPath)</AppHostSourcePath>
    </PropertyGroup>
  </Target>

  <Target Name="LinkSingleFileHost"
          BeforeTargets="_CreateSingleFileHost"
          DependsOnTargets="_GenerateHostFingerprint"
          Inputs="$(SingleFileHostStampFullPath)"
          Outputs="$(SingleFileHostLinkFullPath)"
          Condition="'@(NativeLibrary)' != '' and '$(_UseSingleFileHostForPublish)' == 'true'">

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SingleFileHostLinkFullPath)'))" />
    <Message Importance="high"
             Text="[HostForge.StaticAppHost] LinkSingleFileHost executed for $(StaticHostRid): $(SingleFileHostLinkFullPath)" />
    <Exec Command="&quot;$(CppLinker)&quot; @(_SingleFileHostLinkerArg, ' ')"
          WorkingDirectory="$(StaticHostAssetsDir)" />

    <PropertyGroup>
      <SingleFileHostSourcePath>$(SingleFileHostLinkFullPath)</SingleFileHostSourcePath>
    </PropertyGroup>
  </Target>

</Project>
