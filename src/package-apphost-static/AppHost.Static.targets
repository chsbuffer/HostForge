<Project>

  <PropertyGroup>
    <_StaticHostRid></_StaticHostRid>
    <_StaticHostRid Condition="'$(_StaticHostRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_StaticHostRid>
    <_StaticHostRid Condition="'$(_StaticHostRid)' == '' and '$(AppHostRuntimeIdentifier)' != ''">$(AppHostRuntimeIdentifier)</_StaticHostRid>
    <_StaticHostRid Condition="'$(_StaticHostRid)' == '' and '$(DefaultAppHostRuntimeIdentifier)' != ''">$(DefaultAppHostRuntimeIdentifier)</_StaticHostRid>
  </PropertyGroup>

  <!-- The host libraries embed one .NET runtime, so relink only for the TFM they were built for (see the package props). -->
  <Import Condition="'$(HostForgeStaticAppHostTargetFramework)' != '' and $(TargetFramework.StartsWith('$(HostForgeStaticAppHostTargetFramework)')) and '$(_StaticHostRid)' == 'win-x64' and '$(PublishAot)' != 'true'" Project="$(MSBuildThisFileDirectory)StaticAppHost.targets" />

</Project>
