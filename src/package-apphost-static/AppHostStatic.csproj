<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <StaticAppHostRid Condition="'$(StaticAppHostRid)' == ''">win-x64</StaticAppHostRid>
    <HostLibsFlavor>no-pgo</HostLibsFlavor>
    <HostLibsRoot>$([MSBuild]::NormalizePath('$(HostLibsBaseRoot)', '$(HostLibsFlavor)'))</HostLibsRoot>
    <PackageId>ChsBuffer.AppHost.Static.$(StaticAppHostRid)</PackageId>
    <Version>$(HostLibsVersion)-alpha.1</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Relink AppHost and SingleFileHost from NativeLibrary items with static .NET $(HostLibsVersion) host libs for $(HostLibsTargetFramework) $(StaticAppHostRid).</Description>
    <PackageTags>apphost;single-file;host-template</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>

    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>

    <PackageAssetsDir>$([MSBuild]::NormalizePath('$(HostLibsRoot)', '$(StaticAppHostRid)'))</PackageAssetsDir>
    <_StaticAppHostProps>$(BaseIntermediateOutputPath)$(PackageId).$(HostLibsVersion).props</_StaticAppHostProps>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <ItemGroup>
    <None Include="$(_StaticAppHostProps)" Pack="true" PackagePath="build/$(PackageId).props" />
    <None Include="AppHost.Static.targets" Pack="true" PackagePath="build/$(PackageId).targets" />
    <None Include="..\findvcvarsall.bat" Pack="true" PackagePath="build/findvcvarsall.bat" />
    <None Include="..\StaticAppHost.props" Pack="true" PackagePath="build/StaticAppHost.props" />
    <None Include="..\StaticAppHost.targets" Pack="true" PackagePath="build/StaticAppHost.targets" />
    <None Include="..\StaticAppHost.Windows.targets" Pack="true" PackagePath="build/StaticAppHost.Windows.targets" />
    <None Include="$(PackageAssetsDir)\\**\\*" Pack="true" PackagePath="build/$(StaticAppHostRid)/" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- None Include="README.txt" Pack="true" PackagePath="" /-->
  </ItemGroup>

  <Target Name="_GenerateStaticAppHostProps" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(HostLibsVersion)' == ''"
           Text="No host libs version is defined for HostLibsTargetFramework='$(HostLibsTargetFramework)'. Supported: $(HostForgeTargetFrameworks)." />
    <Error Condition="!$(StaticAppHostRid.StartsWith('win-'))"
           Text="StaticAppHostRid='$(StaticAppHostRid)' is not a Windows RID; the package carries only the Windows link targets." />
    <Error Condition="!Exists('$(PackageAssetsDir)')" Text="Host libs directory not found: $(PackageAssetsDir)" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_StaticAppHostProps)'))" />
    <WriteLinesToFile File="$(_StaticAppHostProps)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;PropertyGroup&gt;;    &lt;HostForgeStaticAppHostTargetFramework&gt;$(HostLibsTargetFramework)&lt;/HostForgeStaticAppHostTargetFramework&gt;;    &lt;HostForgeStaticAppHostRid&gt;$(StaticAppHostRid)&lt;/HostForgeStaticAppHostRid&gt;;  &lt;/PropertyGroup&gt;;&lt;/Project&gt;" />
  </Target>

</Project>
