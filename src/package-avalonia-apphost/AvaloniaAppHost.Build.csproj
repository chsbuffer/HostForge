<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.Avalonia.AppHost.Build</PackageId>
    <Version>$(AvaloniaAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>MSBuild targets and module initializer for ChsBuffer.Avalonia.AppHost prelinked hosts. Consumes AvaloniaAppHostRids registered by per-RID packages.</Description>
    <PackageTags>avalonia;apphost;single-file;host-template;build</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>

    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <ItemGroup>
    <None Include="buildTransitive\AvaloniaAppHost.targets" Pack="true" PackagePath="buildTransitive/ChsBuffer.Avalonia.AppHost.Build.targets" />
    <None Include="buildTransitive\ModuleInitializer.cs" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
