<!--
  Dedicated linking project for Avalonia apphost templates.

  Responsibilities:
  - Resolve the RID set for one OS at a time (`AvaloniaAppHostTarget=windows|linux`).
  - Link `apphost` and `singlefilehost` into `artifacts/avalonia-host/<version>/<rid>/`.
  - Produce artifact folders that can be consumed either by local OS-specific packing or by CI's aggregate `all` pack job.

  Required inputs:
  - `HostLibsRoot`
  - `AvaloniaNativeLibsRoot`
  - `AvaloniaAppHostTarget`

  Optional inputs:
  - `Sysroot`

  This file intentionally does not pack anything. `AvaloniaAppHost.csproj` is the package orchestrator.
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoBuild>true</NoBuild>

    <AvaloniaTemplateTfm Condition="'$(AvaloniaTemplateTfm)' == ''">net10.0</AvaloniaTemplateTfm>
    <AvaloniaAppHostArtifactRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/avalonia-host/$(TargetAvaloniaVersion)'))</AvaloniaAppHostArtifactRoot>
    <_ResolvedSysroot Condition="'$(Sysroot)' != ''">$([MSBuild]::NormalizePath('$(RepoRoot)', '$(Sysroot)'))</_ResolvedSysroot>
    <_AvaloniaAppHostExportsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'apphost.exports'))</_AvaloniaAppHostExportsFile>
    <_AvaloniaSingleFileHostExportsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'singlefilehost.exports'))</_AvaloniaSingleFileHostExportsFile>

    <StaticHostRid>$(AvaloniaHostRid)</StaticHostRid>
    <ComputeNETCoreBuildOutputFiles>true</ComputeNETCoreBuildOutputFiles>
    <_UseSingleFileHostForPublish>true</_UseSingleFileHostForPublish>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AvaloniaHostRid)' != ''">
    <_AvaloniaHostRidIsWindows>$(AvaloniaHostRid.StartsWith('win'))</_AvaloniaHostRidIsWindows>
    <_AvaloniaHostExecutableExtension Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'">.exe</_AvaloniaHostExecutableExtension>
    <_AvaloniaHostExecutableExtension Condition="'$(_AvaloniaHostExecutableExtension)' == ''"></_AvaloniaHostExecutableExtension>

    <PackageAssetsDir>$([MSBuild]::NormalizePath('$(HostLibsRoot)', '$(AvaloniaHostRid)'))</PackageAssetsDir>
    <AvaloniaNativeLibsDir>$([MSBuild]::NormalizePath('$(AvaloniaNativeLibsRoot)', '$(AvaloniaHostRid)'))</AvaloniaNativeLibsDir>
    <AngleNativeLibsDir>$([MSBuild]::NormalizePath('$(AngleNativeLibsRoot)', '$(AvaloniaHostRid)'))</AngleNativeLibsDir>

    <StaticHostAssetsBaseDir>$(HostLibsRoot)</StaticHostAssetsBaseDir>
    <AvaloniaHostOutputDir>$([MSBuild]::NormalizePath('$(AvaloniaAppHostArtifactRoot)', '$(AvaloniaHostRid)'))</AvaloniaHostOutputDir>
    <AppHostLinkPath>$([MSBuild]::NormalizePath('$(AvaloniaHostOutputDir)', 'apphost$(_AvaloniaHostExecutableExtension)'))</AppHostLinkPath>
    <SingleFileHostLinkPath>$([MSBuild]::NormalizePath('$(AvaloniaHostOutputDir)', 'singlefilehost$(_AvaloniaHostExecutableExtension)'))</SingleFileHostLinkPath>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\AvaloniaAppHost.Rids.targets" />
  <Import Project="$(MSBuildProjectDirectory)\..\StaticAppHost.targets" />

  <Target Name="_ValidateAvaloniaAppHostTarget">
    <Error Condition="'$(AvaloniaAppHostTarget)' == ''"
           Text="AvaloniaAppHostTarget is required. Use 'windows' or 'linux'." />
    <Error Condition="'$(AvaloniaAppHostTarget)' != 'windows' and '$(AvaloniaAppHostTarget)' != 'linux'"
           Text="AvaloniaAppHostTarget='$(AvaloniaAppHostTarget)' is invalid. Use 'windows' or 'linux'." />
  </Target>

  <Target Name="_ResolveAvaloniaLinkInputs">
    <PropertyGroup>
      <_AvaloniaHostRidIsWindows>$(AvaloniaHostRid.StartsWith('win'))</_AvaloniaHostRidIsWindows>
      <_AvaloniaNativeLibExtension Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'">.lib</_AvaloniaNativeLibExtension>
      <_AvaloniaNativeLibExtension Condition="'$(_AvaloniaHostRidIsWindows)' != 'True'">.a</_AvaloniaNativeLibExtension>
    </PropertyGroup>

    <Error Condition="'$(AvaloniaHostRid)' == ''"
           Text="AvaloniaHostRid is required for _ResolveAvaloniaLinkInputs." />
    <Error Condition="!Exists('$(PackageAssetsDir)')" Text="Host libs directory not found: $(PackageAssetsDir)" />
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)')" Text="Avalonia native libs directory not found: $(AvaloniaNativeLibsDir)" />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and !Exists('$(AngleNativeLibsDir)')"
           Text="ANGLE native libs directory not found: $(AngleNativeLibsDir)" />

    <ItemGroup>
      <_AvaloniaNativeLib Include="$(AvaloniaNativeLibsDir)/*$(_AvaloniaNativeLibExtension)" />
      <_AngleNativeLib Include="$(AngleNativeLibsDir)/*.lib"
                       Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
    </ItemGroup>

    <Error Condition="'@(_AvaloniaNativeLib)' == ''"
           Text="No $(_AvaloniaNativeLibExtension) files were found in $(AvaloniaNativeLibsDir)." />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and '@(_AngleNativeLib)' == ''"
           Text="No ANGLE static libraries were found in $(AngleNativeLibsDir)." />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and !Exists('$(AngleNativeLibsDir)/av_libglesv2.def')"
           Text="ANGLE export definition file was not found: $(AngleNativeLibsDir)/av_libglesv2.def" />

    <ItemGroup>
      <NativeLibrary Include="@(_AvaloniaNativeLib)" />
      <NativeLibrary Include="@(_AngleNativeLib)" />
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'libHarfBuzzSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'SkiaSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'libSkiaSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <LinkerArg Include="/DEF:&quot;$(AngleNativeLibsDir)/av_libglesv2.def&quot;"
                 Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerInput Include="$(AngleNativeLibsDir)/av_libglesv2.def"
                   Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerArg Include="FontSub.lib;advapi32.lib;d3d11.lib;dxgi.lib;dxguid.lib;gdi32.lib;setupapi.lib;synchronization.lib;user32.lib"
                 Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerArg Include="--sysroot=&quot;$(_ResolvedSysroot)&quot;"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and '$(_ResolvedSysroot)' != ''" />
      <LinkerArg Include="-lfontconfig"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True'" />
      <LinkerArg Include="-Wl,--version-script=$(AvaloniaExportsFile)"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and '$(AvaloniaExportsFile)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="_LinkAvaloniaAppHostForRid"
          DependsOnTargets="_ResolveAvaloniaLinkInputs;LinkAppHost" />

  <Target Name="_LinkAvaloniaSingleFileHostForRid"
          DependsOnTargets="_ResolveAvaloniaLinkInputs;LinkSingleFileHost" />

  <Target Name="LinkAvaloniaHosts"
          DependsOnTargets="_ResolveAvaloniaTargetRids">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_LinkAvaloniaAppHostForRid"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);HostLibsRoot=$(HostLibsRoot);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);AngleNativeLibsRoot=$(AngleNativeLibsRoot);AvaloniaAppHostArtifactRoot=$(AvaloniaAppHostArtifactRoot);AvaloniaTemplateTfm=$(AvaloniaTemplateTfm);AvaloniaHostRid=%(_AvaloniaTargetRid.Identity);Sysroot=$(_ResolvedSysroot);AvaloniaExportsFile=$(_AvaloniaAppHostExportsFile)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_LinkAvaloniaSingleFileHostForRid"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);HostLibsRoot=$(HostLibsRoot);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);AngleNativeLibsRoot=$(AngleNativeLibsRoot);AvaloniaAppHostArtifactRoot=$(AvaloniaAppHostArtifactRoot);AvaloniaTemplateTfm=$(AvaloniaTemplateTfm);AvaloniaHostRid=%(_AvaloniaTargetRid.Identity);Sysroot=$(_ResolvedSysroot);AvaloniaExportsFile=$(_AvaloniaSingleFileHostExportsFile)" />
  </Target>
</Project>
