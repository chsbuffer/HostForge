<!--
  Dedicated linking project for Avalonia apphost templates.

  Responsibilities:
  - Resolve the RID set for one OS at a time (`AvaloniaAppHostTarget=windows|linux|linux-musl`).
  - Link `apphost` and `singlefilehost` for every `AvaloniaTemplateTfms` entry into
    `artifacts/avalonia-host/<version>/<tfm>/<rid>/`. Each TFM links the host libs of its own
    .NET runtime (`HostLibsTargetFramework` selects `HostLibsVersion` in Directory.Build.props).
  - Produce artifact folders that can be consumed either by local OS-specific packing or by CI's aggregate `all` pack job.

  Required inputs:
  - `AvaloniaNativeLibsRoot`
  - `AvaloniaAppHostTarget`

  Optional inputs:
  - `AvaloniaTemplateTfms` (default: `HostForgeTargetFrameworks`)
  - `AvaloniaHostRids`
  - `Sysroot`

  This file intentionally does not pack anything. `ChsBuffer.Avalonia.AppHost.rid.csproj` and `.Build.csproj` are the package orchestrators.
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoBuild>true</NoBuild>

    <AvaloniaTemplateTfm Condition="'$(AvaloniaTemplateTfm)' == ''">$(HostLibsTargetFramework)</AvaloniaTemplateTfm>
    <AvaloniaAppHostArtifactRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/avalonia-host/$(TargetAvaloniaVersion)'))</AvaloniaAppHostArtifactRoot>
    <_ResolvedSysroot Condition="'$(Sysroot)' != ''">$([MSBuild]::NormalizePath('$(RepoRoot)', '$(Sysroot)'))</_ResolvedSysroot>
    <_AvaloniaAppHostExportsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'apphost.exports'))</_AvaloniaAppHostExportsFile>
    <_AvaloniaSingleFileHostExportsFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'singlefilehost.exports'))</_AvaloniaSingleFileHostExportsFile>

    <StaticHostRid>$(AvaloniaHostRid)</StaticHostRid>
    <ComputeNETCoreBuildOutputFiles>true</ComputeNETCoreBuildOutputFiles>
    <_UseSingleFileHostForPublish>true</_UseSingleFileHostForPublish>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AvaloniaHostRid)' != ''">
    <_AvaloniaHostRidIsWindows>$(AvaloniaHostRid.StartsWith('win'))</_AvaloniaHostRidIsWindows>
    <_AvaloniaHostExecutableExtension Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'">.exe</_AvaloniaHostExecutableExtension>
    <_AvaloniaHostExecutableExtension Condition="'$(_AvaloniaHostExecutableExtension)' == ''"></_AvaloniaHostExecutableExtension>

    <PackageAssetsDir>$([MSBuild]::NormalizePath('$(HostLibsRoot)', '$(AvaloniaHostRid)'))</PackageAssetsDir>
    <AvaloniaNativeLibsDir>$([MSBuild]::NormalizePath('$(AvaloniaNativeLibsRoot)', '$(AvaloniaHostRid)'))</AvaloniaNativeLibsDir>
    <AngleNativeLibsDir>$([MSBuild]::NormalizePath('$(AngleNativeLibsRoot)', '$(AvaloniaHostRid)'))</AngleNativeLibsDir>

    <StaticHostAssetsBaseDir>$(HostLibsRoot)</StaticHostAssetsBaseDir>
    <AvaloniaHostOutputDir>$([MSBuild]::NormalizePath('$(AvaloniaAppHostArtifactRoot)', '$(AvaloniaTemplateTfm)', '$(AvaloniaHostRid)'))</AvaloniaHostOutputDir>
    <AppHostLinkPath>$([MSBuild]::NormalizePath('$(AvaloniaHostOutputDir)', 'apphost$(_AvaloniaHostExecutableExtension)'))</AppHostLinkPath>
    <SingleFileHostLinkPath>$([MSBuild]::NormalizePath('$(AvaloniaHostOutputDir)', 'singlefilehost$(_AvaloniaHostExecutableExtension)'))</SingleFileHostLinkPath>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\AvaloniaAppHost.Rids.targets" />
  <Import Project="$(MSBuildProjectDirectory)\..\StaticAppHost.targets" />

  <Target Name="_ValidateAvaloniaAppHostTarget">
    <Error Condition="'$(AvaloniaAppHostTarget)' == ''"
           Text="AvaloniaAppHostTarget is required. Use 'windows', 'linux' or 'linux-musl'." />
    <Error Condition="'$(AvaloniaAppHostTarget)' != 'windows' and '$(AvaloniaAppHostTarget)' != 'linux' and '$(AvaloniaAppHostTarget)' != 'linux-musl'"
           Text="AvaloniaAppHostTarget='$(AvaloniaAppHostTarget)' is invalid. Use 'windows', 'linux' or 'linux-musl'." />
  </Target>

  <Target Name="_ResolveAvaloniaLinkInputs">
    <PropertyGroup>
      <_AvaloniaHostRidIsWindows>$(AvaloniaHostRid.StartsWith('win'))</_AvaloniaHostRidIsWindows>
      <_AvaloniaNativeLibExtension Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'">.lib</_AvaloniaNativeLibExtension>
      <_AvaloniaNativeLibExtension Condition="'$(_AvaloniaHostRidIsWindows)' != 'True'">.a</_AvaloniaNativeLibExtension>
      <GroupNativeLibraries Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and $(SkiaSharpVersion.StartsWith('4.'))">true</GroupNativeLibraries>
      <!-- The Alpine triple selects musl's loader and the GCC runtime of the sysroot from any Clang host. -->
      <_AvaloniaHostTargetTriple Condition="'$(AvaloniaHostRid)' == 'linux-musl-x64'">x86_64-alpine-linux-musl</_AvaloniaHostTargetTriple>
      <_AvaloniaHostTargetTriple Condition="'$(AvaloniaHostRid)' == 'linux-musl-arm64'">aarch64-alpine-linux-musl</_AvaloniaHostTargetTriple>
    </PropertyGroup>

    <Error Condition="'$(AvaloniaHostRid)' == ''"
           Text="AvaloniaHostRid is required for _ResolveAvaloniaLinkInputs." />
    <Error Condition="'$(HostLibsVersion)' == ''"
           Text="No host libs version is defined for target framework '$(HostLibsTargetFramework)'. Supported: $(HostForgeTargetFrameworks)." />
    <Error Condition="!Exists('$(PackageAssetsDir)')" Text="Host libs directory not found: $(PackageAssetsDir)" />
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)')" Text="Avalonia native libs directory not found: $(AvaloniaNativeLibsDir)" />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and !Exists('$(AngleNativeLibsDir)')"
           Text="ANGLE native libs directory not found: $(AngleNativeLibsDir)" />

    <ItemGroup>
      <_AvaloniaNativeLib Include="$(AvaloniaNativeLibsDir)/*$(_AvaloniaNativeLibExtension)" />
      <_AvaloniaNativeLib Include="$(AvaloniaNativeLibsDir)/cxx/*.a"
                          Condition="'$(_AvaloniaHostRidIsWindows)' != 'True'" />
      <_AngleNativeLib Include="$(AngleNativeLibsDir)/*.lib"
                       Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
    </ItemGroup>

    <Error Condition="'@(_AvaloniaNativeLib)' == ''"
           Text="No $(_AvaloniaNativeLibExtension) files were found in $(AvaloniaNativeLibsDir)." />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and $(SkiaSharpVersion.StartsWith('4.')) and !Exists('$(AvaloniaNativeLibsDir)/cxx/libc++.a')"
           Text="SkiaSharp 4 requires the bundled target libc++ archive: $(AvaloniaNativeLibsDir)/cxx/libc++.a" />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and '@(_AngleNativeLib)' == ''"
           Text="No ANGLE static libraries were found in $(AngleNativeLibsDir)." />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and !Exists('$(AngleNativeLibsDir)/av_libglesv2.def')"
           Text="ANGLE export definition file was not found: $(AngleNativeLibsDir)/av_libglesv2.def" />

    <ItemGroup>
      <NativeLibrary Include="@(_AvaloniaNativeLib)" />
      <NativeLibrary Include="@(_AngleNativeLib)" />
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'libHarfBuzzSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'SkiaSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'libSkiaSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <LinkerArg Include="/DEF:&quot;$(AngleNativeLibsDir)/av_libglesv2.def&quot;"
                 Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerInput Include="$(AngleNativeLibsDir)/av_libglesv2.def"
                   Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerArg Include="FontSub.lib;advapi32.lib;d3d11.lib;d3d12.lib;d3dcompiler.lib;dxgi.lib;dxguid.lib;gdi32.lib;setupapi.lib;synchronization.lib;user32.lib"
                 Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
      <LinkerArg Include="--sysroot=&quot;$(_ResolvedSysroot)&quot;"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and '$(_ResolvedSysroot)' != ''" />
      <LinkerArg Include="--target=$(_AvaloniaHostTargetTriple)"
                 Condition="'$(_AvaloniaHostTargetTriple)' != ''" />
      <LinkerArg Include="-lfontconfig"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True'" />
      <LinkerArg Include="-Wl,--version-script=$(AvaloniaExportsFile)"
                 Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and '$(AvaloniaExportsFile)' != ''" />
    </ItemGroup>
  </Target>

  <!--
    Copies the licenses of the linked inputs next to the templates, by component: the .NET runtime of the
    host libs, SkiaSharp (Skia, HarfBuzz, the third-party code in their archives and, for Linux SkiaSharp 4,
    libc++) and, on Windows, ANGLE. The RID package turns them into its THIRD-PARTY-NOTICES.txt.
  -->
  <Target Name="_CopyAvaloniaHostLicenses"
          DependsOnTargets="_ResolveAvaloniaLinkInputs">
    <PropertyGroup>
      <_AvaloniaHostLicensesDir>$([MSBuild]::NormalizePath('$(AvaloniaHostOutputDir)', 'licenses'))</_AvaloniaHostLicensesDir>
      <_AvaloniaLibcxxLicense Condition="'$(_AvaloniaHostRidIsWindows)' != 'True' and $(SkiaSharpVersion.StartsWith('4.'))">$(MSBuildProjectDirectory)/../package-skiasharp-static/licenses/libcxx.LICENSE.TXT</_AvaloniaLibcxxLicense>
    </PropertyGroup>

    <Error Condition="!Exists('$(PackageAssetsDir)/licenses/THIRD-PARTY-NOTICES.TXT')"
           Text=".NET runtime notices not found in $(PackageAssetsDir)/licenses. Rebuild the host libs with task build-hostlibs." />
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)/licenses/skia/LICENSE')"
           Text="SkiaSharp licenses not found in $(AvaloniaNativeLibsDir)/licenses. Rebuild the payload with task build-skiasharp." />
    <Error Condition="'$(_AvaloniaHostRidIsWindows)' == 'True' and !Exists('$(AngleNativeLibsDir)/licenses/angle/LICENSE')"
           Text="ANGLE licenses not found in $(AngleNativeLibsDir)/licenses. Rebuild the payload with task build-angle." />

    <ItemGroup>
      <_AvaloniaHostLicense Include="$(PackageAssetsDir)/licenses/**/*" Component="dotnet/$(HostLibsVersion)" />
      <_AvaloniaHostLicense Include="$(AvaloniaNativeLibsDir)/licenses/**/*" Component="skiasharp" />
      <_AvaloniaHostLicense Include="$(AngleNativeLibsDir)/licenses/**/*" Component="angle"
                            Condition="'$(_AvaloniaHostRidIsWindows)' == 'True'" />
    </ItemGroup>

    <RemoveDir Directories="$(_AvaloniaHostLicensesDir)" />
    <Copy SourceFiles="@(_AvaloniaHostLicense)"
          DestinationFiles="@(_AvaloniaHostLicense->'$(_AvaloniaHostLicensesDir)/%(Component)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(_AvaloniaLibcxxLicense)"
          DestinationFiles="$(_AvaloniaHostLicensesDir)/skiasharp/libcxx/LICENSE.TXT"
          Condition="'$(_AvaloniaLibcxxLicense)' != ''" />
  </Target>

  <Target Name="_LinkAvaloniaAppHostForRid"
          DependsOnTargets="_ResolveAvaloniaLinkInputs;LinkAppHost;_CopyAvaloniaHostLicenses" />

  <Target Name="_LinkAvaloniaSingleFileHostForRid"
          DependsOnTargets="_ResolveAvaloniaLinkInputs;LinkSingleFileHost" />

  <Target Name="LinkAvaloniaHosts"
          DependsOnTargets="_ResolveAvaloniaTargetRids">
    <ItemGroup>
      <_AvaloniaLinkTfm Include="$(AvaloniaTemplateTfms)" />
      <!-- Cross join: one link target per template TFM and RID. -->
      <_AvaloniaLinkTarget Include="@(_AvaloniaLinkTfm)">
        <Rid>%(_AvaloniaTargetRid.Identity)</Rid>
      </_AvaloniaLinkTarget>
      <!-- HostLibsRoot is derived from HostLibsTargetFramework inside each link evaluation. -->
      <_AvaloniaLinkTarget>
        <AdditionalProperties>HostLibsTargetFramework=%(Identity);AvaloniaTemplateTfm=%(Identity)</AdditionalProperties>
      </_AvaloniaLinkTarget>
    </ItemGroup>

    <Error Condition="'@(_AvaloniaLinkTfm)' == ''" Text="AvaloniaTemplateTfms is empty." />

    <!--
      Batches run one RID at a time and the TFMs of that RID link in parallel. Each TFM writes its own
      <tfm>/<rid> output, stamp and merged module definition, so at most one link per TFM runs at once.
    -->
    <MSBuild Projects="@(_AvaloniaLinkTarget->'$(MSBuildProjectFullPath)')"
             Targets="_LinkAvaloniaAppHostForRid"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);AngleNativeLibsRoot=$(AngleNativeLibsRoot);AvaloniaAppHostArtifactRoot=$(AvaloniaAppHostArtifactRoot);AvaloniaHostRid=%(_AvaloniaLinkTarget.Rid);Sysroot=$(_ResolvedSysroot);AvaloniaExportsFile=$(_AvaloniaAppHostExportsFile)" />
    <MSBuild Projects="@(_AvaloniaLinkTarget->'$(MSBuildProjectFullPath)')"
             Targets="_LinkAvaloniaSingleFileHostForRid"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);AngleNativeLibsRoot=$(AngleNativeLibsRoot);AvaloniaAppHostArtifactRoot=$(AvaloniaAppHostArtifactRoot);AvaloniaHostRid=%(_AvaloniaLinkTarget.Rid);Sysroot=$(_ResolvedSysroot);AvaloniaExportsFile=$(_AvaloniaSingleFileHostExportsFile)" />
  </Target>
</Project>
