<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.Avalonia.AppHost.$(AvaloniaHostRid)</PackageId>
    <Version>$(AvaloniaAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Prelinked Avalonia apphost/singlefilehost templates for $(AvaloniaHostRid), with static native libraries.</Description>
    <PackageTags>avalonia;apphost;single-file;host-template;$(AvaloniaHostRid)</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>

    <AvaloniaTemplateTfm Condition="'$(AvaloniaTemplateTfm)' == ''">net10.0</AvaloniaTemplateTfm>
    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>
    <AvaloniaAppHostArtifactRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/avalonia-host/$(TargetAvaloniaVersion)'))</AvaloniaAppHostArtifactRoot>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\AvaloniaAppHost.Rids.targets" />

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzVersion)" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives"
                      Version="$(AngleVersion)"
                      Condition="'$(AvaloniaHostRid)' == 'win-x64' or '$(AvaloniaHostRid)' == 'win-arm64'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\AvaloniaAppHost.$(AvaloniaHostRid).props" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="_CollectAvaloniaHostTemplates"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ResolveAvaloniaSinglePackRid">
    <ItemGroup>
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackRid->'%(HostOutputDir)/apphost%(ExecutableExtension)')">
        <PackagePath>template/$(AvaloniaTemplateTfm)/%(_AvaloniaPackRid.Identity)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackRid->'%(HostOutputDir)/singlefilehost%(ExecutableExtension)')">
        <PackagePath>template/$(AvaloniaTemplateTfm)/%(_AvaloniaPackRid.Identity)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>

      <_AvaloniaMissingTemplateHostFile Include="@(_AvaloniaTemplateHostFileToPack)"
                                        Condition="!Exists('%(Identity)')" />

      <None Include="@(_AvaloniaTemplateHostFileToPack)"
            Pack="true"
            PackagePath="%(_AvaloniaTemplateHostFileToPack.PackagePath)" />
    </ItemGroup>

    <Error Condition="'@(_AvaloniaMissingTemplateHostFile)' != ''"
           Text="Missing Avalonia apphost template artifacts under $(AvaloniaAppHostArtifactRoot): @(_AvaloniaMissingTemplateHostFile, ', ')." />
  </Target>
</Project>
