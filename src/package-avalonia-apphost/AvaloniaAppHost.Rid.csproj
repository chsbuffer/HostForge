<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseIntermediateOutputPath Condition="'$(AvaloniaHostRid)' != ''">obj/$(MSBuildProjectName).$(AvaloniaHostRid)/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.Avalonia.AppHost.$(AvaloniaHostRid)</PackageId>
    <Version>$(AvaloniaAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Prelinked Avalonia apphost/singlefilehost templates for $(AvaloniaHostRid) ($(AvaloniaTemplateTfms.Replace(";", ", "))), with static native libraries.</Description>
    <PackageTags>avalonia;apphost;single-file;host-template;$(AvaloniaHostRid)</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>

    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>
    <AvaloniaAppHostArtifactRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/avalonia-host/$(TargetAvaloniaVersion)'))</AvaloniaAppHostArtifactRoot>
    <_AvaloniaRidProps>$(BaseIntermediateOutputPath)$(PackageId).props</_AvaloniaRidProps>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\AvaloniaAppHost.Rids.targets" />

  <ItemGroup>
    <ProjectReference Include="AvaloniaAppHost.Build.csproj" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzVersion)" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives"
                      Version="$(AngleVersion)"
                      Condition="'$(AvaloniaHostRid)' == 'win-x64' or '$(AvaloniaHostRid)' == 'win-arm64'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(_AvaloniaRidProps)" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
    <None Include="README.$(AvaloniaHostRid).md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!--
    Packs template/<tfm>/<rid>/{apphost,singlefilehost}[.exe] for every AvaloniaTemplateTfms entry and
    registers each one with an AvaloniaAppHostRids item. The Build package activates the item whose
    RID and TFM match the consuming project.
  -->
  <Target Name="_CollectAvaloniaHostTemplates"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ResolveAvaloniaSinglePackRid">
    <PropertyGroup>
      <_AvaloniaPackRidExtension>@(_AvaloniaPackRid->'%(ExecutableExtension)')</_AvaloniaPackRidExtension>
    </PropertyGroup>

    <ItemGroup>
      <_AvaloniaPackTfm Include="$(AvaloniaTemplateTfms)" />
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackTfm->'$(AvaloniaAppHostArtifactRoot)/%(Identity)/$(AvaloniaHostRid)/apphost$(_AvaloniaPackRidExtension)')">
        <PackagePath>template/%(Identity)/$(AvaloniaHostRid)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackTfm->'$(AvaloniaAppHostArtifactRoot)/%(Identity)/$(AvaloniaHostRid)/singlefilehost$(_AvaloniaPackRidExtension)')">
        <PackagePath>template/%(Identity)/$(AvaloniaHostRid)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>

      <_AvaloniaMissingTemplateHostFile Include="@(_AvaloniaTemplateHostFileToPack)"
                                        Condition="!Exists('%(Identity)')" />

      <None Include="@(_AvaloniaTemplateHostFileToPack)"
            Pack="true"
            PackagePath="%(_AvaloniaTemplateHostFileToPack.PackagePath)" />

      <!-- %24 keeps the MSBuild expressions literal in the generated props. -->
      <_AvaloniaRidRegistration Include="@(_AvaloniaPackTfm)">
        <Text><![CDATA[    <AvaloniaAppHostRids Include="$(AvaloniaHostRid)">
      <AppHostTemplateTfm>%(Identity)</AppHostTemplateTfm>
      <AppHostTemplatePath>%24([MSBuild]::NormalizePath('%24(MSBuildThisFileDirectory)', '..', 'template/%(Identity)/$(AvaloniaHostRid)/apphost$(_AvaloniaPackRidExtension)'))</AppHostTemplatePath>
      <SingleFileHostTemplatePath>%24([MSBuild]::NormalizePath('%24(MSBuildThisFileDirectory)', '..', 'template/%(Identity)/$(AvaloniaHostRid)/singlefilehost$(_AvaloniaPackRidExtension)'))</SingleFileHostTemplatePath>
    </AvaloniaAppHostRids>]]></Text>
      </_AvaloniaRidRegistration>
    </ItemGroup>

    <Error Condition="'@(_AvaloniaPackTfm)' == ''"
           Text="AvaloniaTemplateTfms is empty." />
    <Error Condition="'@(_AvaloniaMissingTemplateHostFile)' != ''"
           Text="Missing Avalonia apphost template artifacts under $(AvaloniaAppHostArtifactRoot): @(_AvaloniaMissingTemplateHostFile, ', ')." />

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_AvaloniaRidProps)'))" />
    <WriteLinesToFile File="$(_AvaloniaRidProps)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;ItemGroup&gt;;@(_AvaloniaRidRegistration->'%(Text)');  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
</Project>
