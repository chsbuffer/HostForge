<!--
  Shared RID definitions for Avalonia apphost link/pack orchestration.

  Add a new RID once here, then both:
  - AvaloniaAppHost.Link.proj RID linking (_ResolveAvaloniaTargetRids)
  - AvaloniaAppHost.Rid.csproj template packing (_ResolveAvaloniaSinglePackRid)
  consume the same metadata and filtering rules.
-->
<Project>
  <Target Name="_ResolveAvaloniaKnownRids">
    <PropertyGroup>
      <_AvaloniaHostRidsFilter>;$(AvaloniaHostRids);</_AvaloniaHostRidsFilter>
    </PropertyGroup>
    <ItemGroup>
      <_AvaloniaKnownRid Include="win-x64">
        <TargetOs>windows</TargetOs>
        <ExecutableExtension>.exe</ExecutableExtension>
      </_AvaloniaKnownRid>
      <_AvaloniaKnownRid Include="win-arm64">
        <TargetOs>windows</TargetOs>
        <ExecutableExtension>.exe</ExecutableExtension>
      </_AvaloniaKnownRid>
      <_AvaloniaKnownRid Include="linux-x64">
        <TargetOs>linux</TargetOs>
        <ExecutableExtension></ExecutableExtension>
      </_AvaloniaKnownRid>
    </ItemGroup>
  </Target>

  <Target Name="_ResolveAvaloniaSinglePackRid"
          DependsOnTargets="_ResolveAvaloniaKnownRids">
    <ItemGroup>
      <_AvaloniaPackRid Include="@(_AvaloniaKnownRid)"
                        Condition="'$(AvaloniaHostRid)' == '%(_AvaloniaKnownRid.Identity)'">
        <TargetOs>%(_AvaloniaKnownRid.TargetOs)</TargetOs>
        <ExecutableExtension>%(_AvaloniaKnownRid.ExecutableExtension)</ExecutableExtension>
        <HostOutputDir>$([MSBuild]::NormalizePath('$(AvaloniaAppHostArtifactRoot)', '%(_AvaloniaKnownRid.Identity)'))</HostOutputDir>
      </_AvaloniaPackRid>
    </ItemGroup>

    <Error Condition="'$(AvaloniaHostRid)' == ''"
           Text="AvaloniaHostRid is required." />
    <Error Condition="'@(_AvaloniaPackRid)' == ''"
           Text="Unknown AvaloniaHostRid: '$(AvaloniaHostRid)'. Known RIDs: @(_AvaloniaKnownRid->'%(Identity)', ', ')." />
  </Target>

  <Target Name="_ResolveAvaloniaTargetRids"
          DependsOnTargets="_ValidateAvaloniaAppHostTarget;_ResolveAvaloniaKnownRids">
    <ItemGroup>
      <_AvaloniaTargetRid Include="@(_AvaloniaKnownRid)"
                          Condition="'$(AvaloniaAppHostTarget)' == '%(_AvaloniaKnownRid.TargetOs)' and ('$(AvaloniaHostRids)' == '' or $(_AvaloniaHostRidsFilter.Contains(';%(_AvaloniaKnownRid.Identity);')))">
        <TargetOs>%(_AvaloniaKnownRid.TargetOs)</TargetOs>
        <ExecutableExtension>%(_AvaloniaKnownRid.ExecutableExtension)</ExecutableExtension>
      </_AvaloniaTargetRid>
    </ItemGroup>

    <Error Condition="'@(_AvaloniaTargetRid)' == ''"
           Text="No linkable Avalonia apphost RIDs for target '$(AvaloniaAppHostTarget)'." />
  </Target>
</Project>
