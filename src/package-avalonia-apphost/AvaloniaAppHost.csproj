<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.Avalonia.AppHost</PackageId>
    <Version>$(AvaloniaAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Prelinked Avalonia 11 apphost/singlefilehost templates for .NET 10 on Windows win-x64/win-arm64, with optional SkiaSharp/HarfBuzz native runtime copy suppression.</Description>
    <PackageTags>avalonia;apphost;single-file;host-template;skia;harfbuzz</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>

    <AvaloniaTemplateTfm Condition="'$(AvaloniaTemplateTfm)' == ''">net10.0</AvaloniaTemplateTfm>
    <AvaloniaHostRids>win-x64;win-arm64</AvaloniaHostRids>
    <PackageAssetsDir>$(HostLibsRoot)\$(AvaloniaHostRid)</PackageAssetsDir>
    <AvaloniaNativeLibsDir>$(AvaloniaNativeLibsRoot)\$(AvaloniaHostRid)</AvaloniaNativeLibsDir>
    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>

    <AvaloniaHostOutputDir>$(BaseIntermediateOutputPath)avalonia-host\$(AvaloniaHostRid)</AvaloniaHostOutputDir>
    <AvaloniaAppHostOutput>$(AvaloniaHostOutputDir)\apphost.exe</AvaloniaAppHostOutput>
    <AvaloniaSingleFileHostOutput>$(AvaloniaHostOutputDir)\singlefilehost.exe</AvaloniaSingleFileHostOutput>

    <StaticHostRid>$(AvaloniaHostRid)</StaticHostRid>
    <AppHostLinkPath>$(AvaloniaAppHostOutput)</AppHostLinkPath>
    <SingleFileHostLinkPath>$(AvaloniaSingleFileHostOutput)</SingleFileHostLinkPath>
    <ComputeNETCoreBuildOutputFiles>true</ComputeNETCoreBuildOutputFiles>
    <_UseSingleFileHostForPublish>true</_UseSingleFileHostForPublish>
  </PropertyGroup>

  <PropertyGroup>
    <StaticHostAssetsBaseDir>$(HostLibsRoot)</StaticHostAssetsBaseDir>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\..\StaticAppHost.targets" />

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\ChsBuffer.Avalonia.AppHost.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="contentFiles\cs\net10.0\ModuleInitializer.cs" Pack="true" PackagePath="contentFiles/cs/net10.0/" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="_ResolveAvaloniaLinkInputs">
    <Error Condition="'$(AvaloniaHostRid)' != 'win-x64' and '$(AvaloniaHostRid)' != 'win-arm64'" Text="Unsupported AvaloniaHostRid: $(AvaloniaHostRid). Supported values: win-x64;win-arm64." />
    <Error Condition="!Exists('$(PackageAssetsDir)')" Text="Host libs directory not found: $(PackageAssetsDir)" />
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)')" Text="Avalonia native libs directory not found: $(AvaloniaNativeLibsDir)" />

    <ItemGroup>
      <_AvaloniaNativeLib Include="$(AvaloniaNativeLibsDir)\*.lib" />
    </ItemGroup>

    <Error Condition="'@(_AvaloniaNativeLib)' == ''"
           Text="No .lib files were found in $(AvaloniaNativeLibsDir)." />

    <ItemGroup>
      <NativeLibrary Include="@(_AvaloniaNativeLib)" />
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'libHarfBuzzSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <NativeLibrary Update="@(NativeLibrary)" Condition="'%(NativeLibrary.Filename)' == 'SkiaSharp'">
       <WholeArchive>true</WholeArchive>
      </NativeLibrary>
      <LinkerArg Include="FontSub.lib;opengl32.lib;advapi32.lib;gdi32.lib"/>
    </ItemGroup>
  </Target>

  <Target Name="_ResolveAvaloniaPackRids">
    <ItemGroup>
      <_AvaloniaRequestedRid Include="$(AvaloniaHostRids.Split(';'))" />
      <_AvaloniaRequestedRid Remove="@(_AvaloniaRequestedRid)"
                             Condition="'%(_AvaloniaRequestedRid.Identity)' == ''" />

      <_AvaloniaPackRid Include="@(_AvaloniaRequestedRid)"
                        Condition="Exists('$(HostLibsRoot)\%(_AvaloniaRequestedRid.Identity)') and Exists('$(AvaloniaNativeLibsRoot)\%(_AvaloniaRequestedRid.Identity)')" />

      <_AvaloniaMissingRid Include="@(_AvaloniaRequestedRid)"
                           Condition="!Exists('$(HostLibsRoot)\%(_AvaloniaRequestedRid.Identity)') or !Exists('$(AvaloniaNativeLibsRoot)\%(_AvaloniaRequestedRid.Identity)')" />
    </ItemGroup>

    <Warning Condition="'@(_AvaloniaMissingRid)' != ''"
             Text="Skipping Avalonia host RID(s) due to missing inputs: @(_AvaloniaMissingRid, ', '). Expected host libs under $(HostLibsRoot) and native libs under $(AvaloniaNativeLibsRoot)." />

    <Error Condition="'@(_AvaloniaPackRid)' == ''"
           Text="No packable AvaloniaHostRids. Checked: $(AvaloniaHostRids)." />
  </Target>

  <Target Name="_LinkAvaloniaHostsForRid"
          DependsOnTargets="_ResolveAvaloniaLinkInputs;LinkAppHost;LinkSingleFileHost"
          Returns="@(_AvaloniaTemplateHostFile)">
    <ItemGroup>
      <_AvaloniaTemplateHostFile Include="$(AvaloniaAppHostOutput)">
        <PackagePath>template/$(AvaloniaTemplateTfm)/$(AvaloniaHostRid)/</PackagePath>
      </_AvaloniaTemplateHostFile>
      <_AvaloniaTemplateHostFile Include="$(AvaloniaSingleFileHostOutput)">
        <PackagePath>template/$(AvaloniaTemplateTfm)/$(AvaloniaHostRid)/</PackagePath>
      </_AvaloniaTemplateHostFile>
    </ItemGroup>
  </Target>

  <Target Name="LinkAvaloniaHosts"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ResolveAvaloniaPackRids">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_LinkAvaloniaHostsForRid"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);AvaloniaHostRid=%(_AvaloniaPackRid.Identity);AvaloniaTemplateTfm=$(AvaloniaTemplateTfm);HostLibsRoot=$(HostLibsRoot);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);BaseIntermediateOutputPath=$(BaseIntermediateOutputPath)">
      <Output TaskParameter="TargetOutputs"
              ItemName="_AvaloniaTemplateHostFileToPack" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AvaloniaTemplateHostFileToPack)"
            Pack="true"
            PackagePath="%(_AvaloniaTemplateHostFileToPack.PackagePath)" />
    </ItemGroup>
  </Target>
</Project>
