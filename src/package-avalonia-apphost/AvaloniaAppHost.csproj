<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <_AvaloniaAppHostPackageIdSuffix Condition="'$(AvaloniaAppHostPackageMode)' == 'windows'">.Windows</_AvaloniaAppHostPackageIdSuffix>
    <_AvaloniaAppHostPackageIdSuffix Condition="'$(AvaloniaAppHostPackageMode)' == 'linux'">.Linux</_AvaloniaAppHostPackageIdSuffix>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.Avalonia.AppHost$(_AvaloniaAppHostPackageIdSuffix)</PackageId>
    <Version>$(AvaloniaAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Prelinked Avalonia apphost/singlefilehost template package for .NET 10 on Windows and Linux, with optional SkiaSharp/HarfBuzz native runtime copy suppression.</Description>
    <PackageTags>avalonia;apphost;single-file;host-template;skia;harfbuzz</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>

    <AvaloniaTemplateTfm Condition="'$(AvaloniaTemplateTfm)' == ''">net10.0</AvaloniaTemplateTfm>
    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>
    <AvaloniaAppHostArtifactRoot>$([MSBuild]::NormalizePath('$(RepoRoot)', 'artifacts/avalonia-host/$(TargetAvaloniaVersion)'))</AvaloniaAppHostArtifactRoot>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildProjectDirectory)\AvaloniaAppHost.Rids.targets" />

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\ChsBuffer.Avalonia.AppHost.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="contentFiles\cs\net10.0\ModuleInitializer.cs" Pack="true" PackagePath="contentFiles/cs/net10.0/" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="_ValidateAvaloniaAppHostPackageMode">
    <Error Condition="'$(AvaloniaAppHostPackageMode)' == ''"
           Text="AvaloniaAppHostPackageMode is required. Use 'windows', 'linux', or 'all'." />
    <Error Condition="'$(AvaloniaAppHostPackageMode)' != 'windows' and '$(AvaloniaAppHostPackageMode)' != 'linux' and '$(AvaloniaAppHostPackageMode)' != 'all'"
           Text="AvaloniaAppHostPackageMode='$(AvaloniaAppHostPackageMode)' is invalid. Use 'windows', 'linux', or 'all'." />
  </Target>

  <Target Name="_LinkAvaloniaHostsForPackage"
          DependsOnTargets="_ValidateAvaloniaAppHostPackageMode"
          Condition="'$(AvaloniaAppHostPackageMode)' != 'all'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\AvaloniaAppHost.Link.proj"
             Targets="LinkAvaloniaHosts"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetAvaloniaVersion=$(TargetAvaloniaVersion);HostLibsRoot=$(HostLibsRoot);AvaloniaNativeLibsRoot=$(AvaloniaNativeLibsRoot);AvaloniaAppHostArtifactRoot=$(AvaloniaAppHostArtifactRoot);AvaloniaTemplateTfm=$(AvaloniaTemplateTfm);AvaloniaAppHostTarget=$(AvaloniaAppHostPackageMode)" />
  </Target>

  <Target Name="_CollectAvaloniaHostTemplates"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ResolveAvaloniaPackRids;_LinkAvaloniaHostsForPackage">
    <ItemGroup>
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackRid->'%(HostOutputDir)/apphost%(ExecutableExtension)')">
        <PackagePath>template/$(AvaloniaTemplateTfm)/%(_AvaloniaPackRid.Identity)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>
      <_AvaloniaTemplateHostFileToPack Include="@(_AvaloniaPackRid->'%(HostOutputDir)/singlefilehost%(ExecutableExtension)')">
        <PackagePath>template/$(AvaloniaTemplateTfm)/%(_AvaloniaPackRid.Identity)/</PackagePath>
      </_AvaloniaTemplateHostFileToPack>

      <_AvaloniaMissingTemplateHostFile Include="@(_AvaloniaTemplateHostFileToPack)"
                                        Condition="!Exists('%(Identity)')" />

      <None Include="@(_AvaloniaTemplateHostFileToPack)"
            Pack="true"
            PackagePath="%(_AvaloniaTemplateHostFileToPack.PackagePath)" />
    </ItemGroup>

    <Error Condition="'@(_AvaloniaMissingTemplateHostFile)' != ''"
           Text="Missing Avalonia apphost template artifacts under $(AvaloniaAppHostArtifactRoot): @(_AvaloniaMissingTemplateHostFile, ', ')." />
  </Target>
</Project>
