<Project>
  <PropertyGroup>
    <DisableSkiaHarfBuzzRuntimeCopy Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == ''">true</DisableSkiaHarfBuzzRuntimeCopy>
    <DisableAngleRuntimeCopy Condition="'$(DisableAngleRuntimeCopy)' == ''">true</DisableAngleRuntimeCopy>
    <DetectAvaloniaDesigner Condition="'$(DetectAvaloniaDesigner)' == ''">true</DetectAvaloniaDesigner>
  </PropertyGroup>

  <PropertyGroup>
    <_AvaloniaModuleInitializer>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'ModuleInitializer.cs'))</_AvaloniaModuleInitializer>
    <_AvaloniaSkiaNativeFileNames>;libSkiaSharp.dll;libSkiaSharp.so;</_AvaloniaSkiaNativeFileNames>
    <_AvaloniaHarfBuzzNativeFileNames>;libHarfBuzzSharp.dll;libHarfBuzzSharp.so;</_AvaloniaHarfBuzzNativeFileNames>
    <_AvaloniaAngleNativeFileNames>;av_libglesv2.dll;</_AvaloniaAngleNativeFileNames>
  </PropertyGroup>

  <Target Name="ResolveAvaloniaAppHostActivation"
          BeforeTargets="PrepareForBuild;_GetAppHostPaths">
    <PropertyGroup>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">$(TargetFramework)</_AvaloniaTemplateTfm>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">net10.0</_AvaloniaTemplateTfm>

      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(RuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(AppHostRuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(DefaultAppHostRuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">win-x64</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRidLower>$([System.String]::Copy('$(_AvaloniaTemplateRid)').ToLowerInvariant())</_AvaloniaTemplateRidLower>
      <_AvaloniaTemplateTfmLower>$([System.String]::Copy('$(_AvaloniaTemplateTfm)').ToLowerInvariant())</_AvaloniaTemplateTfmLower>
      <_AvaloniaTemplateRidIsWindows Condition="'$(_AvaloniaTemplateRid)' != ''">$(_AvaloniaTemplateRid.StartsWith('win'))</_AvaloniaTemplateRidIsWindows>
    </PropertyGroup>

    <ItemGroup>
      <_AvaloniaMatchedRid Include="@(AvaloniaAppHostRids)"
        Condition="'$(_AvaloniaTemplateRidLower)' != ''
                   and $([System.String]::Copy('%(Identity)').ToLowerInvariant()) == '$(_AvaloniaTemplateRidLower)'
                   and $([System.String]::Copy('%(AppHostTemplateTfm)').ToLowerInvariant()) == '$(_AvaloniaTemplateTfmLower)'" />
    </ItemGroup>

    <PropertyGroup>
      <AvaloniaAppHostActive Condition="'$(AvaloniaAppHostActive)' == '' and '$(TargetFramework)' != ''
          and '@(_AvaloniaMatchedRid)' != ''
          and Exists('@(_AvaloniaMatchedRid->'%(AppHostTemplatePath)')')
          and Exists('@(_AvaloniaMatchedRid->'%(SingleFileHostTemplatePath)')')">true</AvaloniaAppHostActive>
      <AvaloniaAppHostActive Condition="'$(AvaloniaAppHostActive)' == ''">false</AvaloniaAppHostActive>

      <AppHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(AppHostSourcePath)' == ''">@(_AvaloniaMatchedRid->'%(AppHostTemplatePath)')</AppHostSourcePath>
      <SingleFileHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(SingleFileHostSourcePath)' == ''">@(_AvaloniaMatchedRid->'%(SingleFileHostTemplatePath)')</SingleFileHostSourcePath>
    </PropertyGroup>
  </Target>

  <Target Name="InjectAvaloniaModuleInitializer"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(AvaloniaAppHostActive)' == 'true' and Exists('$(_AvaloniaModuleInitializer)')">
    <PropertyGroup>
        <DefineConstants Condition="'$(DetectAvaloniaDesigner)' == 'true'">$(DefineConstants);DETECT_AVALONIA_DESIGNER</DefineConstants>
        <DefineConstants Condition="'$(_AvaloniaTemplateRidIsWindows)' != 'True'">$(DefineConstants);HOSTFORGE_DISABLE_AVALONIA_WIN32_IMPORT_RESOLVER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="$(_AvaloniaModuleInitializer)"
               Link="HostForge\Avalonia\ModuleInitializer.g.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="WarnAvaloniaAppHostInactive"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(TargetFramework)' != '' and '$(AvaloniaAppHostActive)' != 'true'">
    <Warning Text="ChsBuffer.Avalonia.AppHost is inactive for TargetFramework='$(TargetFramework)' RuntimeIdentifier='$(RuntimeIdentifier)'. No matching AvaloniaAppHostRids item for TFM '$(_AvaloniaTemplateTfm)'. Registered: @(AvaloniaAppHostRids->'%(Identity)', ', '). Host replacement and ANGLE/Skia/HarfBuzz runtime copy suppression are disabled." />
  </Target>

  <Target Name="DisableAnglePublishItems"
          BeforeTargets="_CopyResolvedFilesToPublishPreserveNewest;_CopyResolvedFilesToPublishAlways"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(DisableAngleRuntimeCopy)' == 'true' and '$(AvaloniaAppHostActive)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$(_AvaloniaAngleNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)"
                                            Condition="$(_AvaloniaAngleNativeFileNames.Contains(';%(_ResolvedFileToPublishPreserveNewest.Filename)%(_ResolvedFileToPublishPreserveNewest.Extension);'))" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)"
                                    Condition="$(_AvaloniaAngleNativeFileNames.Contains(';%(_ResolvedFileToPublishAlways.Filename)%(_ResolvedFileToPublishAlways.Extension);'))" />
    </ItemGroup>
  </Target>

  <Target Name="DisableSkiaHarfBuzzPublishItems"
          BeforeTargets="_CopyResolvedFilesToPublishPreserveNewest;_CopyResolvedFilesToPublishAlways"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == 'true' and '$(AvaloniaAppHostActive)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)"
                                            Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(_ResolvedFileToPublishPreserveNewest.Filename)%(_ResolvedFileToPublishPreserveNewest.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(_ResolvedFileToPublishPreserveNewest.Filename)%(_ResolvedFileToPublishPreserveNewest.Extension);'))" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)"
                                    Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(_ResolvedFileToPublishAlways.Filename)%(_ResolvedFileToPublishAlways.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(_ResolvedFileToPublishAlways.Filename)%(_ResolvedFileToPublishAlways.Extension);'))" />
    </ItemGroup>
  </Target>
</Project>
