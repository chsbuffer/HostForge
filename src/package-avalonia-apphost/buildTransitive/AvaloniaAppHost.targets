<Project>
  <PropertyGroup>
    <DisableSkiaHarfBuzzRuntimeCopy Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == ''">true</DisableSkiaHarfBuzzRuntimeCopy>
    <DisableAngleRuntimeCopy Condition="'$(DisableAngleRuntimeCopy)' == ''">true</DisableAngleRuntimeCopy>
  </PropertyGroup>

  <PropertyGroup>
    <_AvaloniaModuleInitializer>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'ModuleInitializer.cs'))</_AvaloniaModuleInitializer>
    <_AvaloniaSkiaHarfBuzzNativeFileNames>;libSkiaSharp.dll;libSkiaSharp.so;libSkiaSharp.dylib;libSkiaSharp.pdb;libHarfBuzzSharp.dll;libHarfBuzzSharp.so;libHarfBuzzSharp.dylib;libHarfBuzzSharp.pdb;</_AvaloniaSkiaHarfBuzzNativeFileNames>
    <_AvaloniaAngleNativeFileNames>;av_libglesv2.dll;av_libglesv2.pdb;</_AvaloniaAngleNativeFileNames>
  </PropertyGroup>

  <Target Name="ResolveAvaloniaAppHostActivation"
          BeforeTargets="PrepareForBuild;_GetAppHostPaths">
    <PropertyGroup>
      <!-- Templates depend only on the .NET runtime, so net11.0-windows uses the net11.0 template. -->
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(TargetFrameworkVersion)' != ''">net$(TargetFrameworkVersion.TrimStart('vV'))</_AvaloniaTemplateTfm>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">$(TargetFramework)</_AvaloniaTemplateTfm>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">net10.0</_AvaloniaTemplateTfm>

      <!--
        A template serves only its own RID. A build without a RuntimeIdentifier is portable: it keeps the
        dynamic libraries of every RID and runs on the SDK host.
      -->
      <_AvaloniaTemplateRid>$(RuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRidLower>$([System.String]::Copy('$(_AvaloniaTemplateRid)').ToLowerInvariant())</_AvaloniaTemplateRidLower>
      <_AvaloniaTemplateTfmLower>$([System.String]::Copy('$(_AvaloniaTemplateTfm)').ToLowerInvariant())</_AvaloniaTemplateTfmLower>
      <_AvaloniaTemplateRidIsWindows Condition="'$(_AvaloniaTemplateRid)' != ''">$(_AvaloniaTemplateRid.StartsWith('win'))</_AvaloniaTemplateRidIsWindows>
    </PropertyGroup>

    <ItemGroup>
      <_AvaloniaMatchedRid Include="@(AvaloniaAppHostRids)"
        Condition="'$(_AvaloniaTemplateRidLower)' != ''
                   and $([System.String]::Copy('%(Identity)').ToLowerInvariant()) == '$(_AvaloniaTemplateRidLower)'
                   and $([System.String]::Copy('%(AppHostTemplateTfm)').ToLowerInvariant()) == '$(_AvaloniaTemplateTfmLower)'" />
    </ItemGroup>

    <!--
      NativeAOT and UseAppHost=false run without an apphost, so nothing would load the libraries that the
      publish step removes. ChsBuffer.SkiaSharp.Static and ChsBuffer.Angle.Static link them into NativeAOT
      executables instead. The module initializer that resolves them from the executable is C#.
    -->
    <PropertyGroup Condition="'$(AvaloniaAppHostActive)' == '' and '$(TargetFramework)' != '' and '$(_AvaloniaTemplateRid)' != ''">
      <_AvaloniaAppHostInactiveReason Condition="'$(PublishAot)' == 'true'">PublishAot</_AvaloniaAppHostInactiveReason>
      <_AvaloniaAppHostInactiveReason Condition="'$(_AvaloniaAppHostInactiveReason)' == '' and '$(Language)' != 'C#'">Language</_AvaloniaAppHostInactiveReason>
      <_AvaloniaAppHostInactiveReason Condition="'$(_AvaloniaAppHostInactiveReason)' == ''
          and !('@(_AvaloniaMatchedRid)' != ''
                and Exists('@(_AvaloniaMatchedRid->'%(AppHostTemplatePath)')')
                and Exists('@(_AvaloniaMatchedRid->'%(SingleFileHostTemplatePath)')'))">NoTemplate</_AvaloniaAppHostInactiveReason>
      <_AvaloniaAppHostInactiveReason Condition="'$(_AvaloniaAppHostInactiveReason)' == '' and '$(UseAppHost)' == 'false'">UseAppHost</_AvaloniaAppHostInactiveReason>
      <AvaloniaAppHostActive Condition="'$(_AvaloniaAppHostInactiveReason)' == ''">true</AvaloniaAppHostActive>
    </PropertyGroup>

    <PropertyGroup>
      <AvaloniaAppHostActive Condition="'$(AvaloniaAppHostActive)' == ''">false</AvaloniaAppHostActive>

      <AppHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(AppHostSourcePath)' == ''">@(_AvaloniaMatchedRid->'%(AppHostTemplatePath)')</AppHostSourcePath>
      <SingleFileHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(SingleFileHostSourcePath)' == ''">@(_AvaloniaMatchedRid->'%(SingleFileHostTemplatePath)')</SingleFileHostSourcePath>
    </PropertyGroup>
  </Target>

  <!--
    Each constant enables the registration of one assembly in @(ReferencePath), which is resolved before
    BeforeCompile. Only the Windows templates contain ANGLE, which Avalonia.Win32 imports.
    Running before BeforeCompile also puts the initializer and its constants into the compile input cache, so
    a build that changes the activation in the same intermediate directory, such as one with UseAppHost=false,
    recompiles the assembly instead of keeping or missing the initializer of the previous build.
  -->
  <Target Name="InjectAvaloniaModuleInitializer"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="Exists('$(_AvaloniaModuleInitializer)')">
    <PropertyGroup Condition="'$(AvaloniaAppHostActive)' == 'true'">
      <DefineConstants Condition="'@(ReferencePath->AnyHaveMetadataValue('Filename', 'SkiaSharp'))' == 'true'">$(DefineConstants);HOSTFORGE_SKIASHARP</DefineConstants>
      <DefineConstants Condition="'@(ReferencePath->AnyHaveMetadataValue('Filename', 'SkiaSharp.Skottie'))' == 'true'">$(DefineConstants);HOSTFORGE_SKIASHARP_SKOTTIE</DefineConstants>
      <DefineConstants Condition="'@(ReferencePath->AnyHaveMetadataValue('Filename', 'SkiaSharp.SceneGraph'))' == 'true'">$(DefineConstants);HOSTFORGE_SKIASHARP_SCENEGRAPH</DefineConstants>
      <DefineConstants Condition="'@(ReferencePath->AnyHaveMetadataValue('Filename', 'SkiaSharp.Resources'))' == 'true'">$(DefineConstants);HOSTFORGE_SKIASHARP_RESOURCES</DefineConstants>
      <DefineConstants Condition="'@(ReferencePath->AnyHaveMetadataValue('Filename', 'HarfBuzzSharp'))' == 'true'">$(DefineConstants);HOSTFORGE_HARFBUZZSHARP</DefineConstants>
      <DefineConstants Condition="'$(_AvaloniaTemplateRidIsWindows)' == 'True' and '@(ReferencePath->AnyHaveMetadataValue('Filename', 'Avalonia.Win32'))' == 'true'">$(DefineConstants);HOSTFORGE_AVALONIA_WIN32</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(AvaloniaAppHostActive)' == 'true'">
      <Compile Include="$(_AvaloniaModuleInitializer)"
               Link="HostForge\Avalonia\ModuleInitializer.g.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="WarnAvaloniaAppHostInactive"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ResolveAvaloniaAppHostActivation">
    <PropertyGroup>
      <_AvaloniaAppHostInactive>ChsBuffer.Avalonia.AppHost is inactive for TargetFramework='$(TargetFramework)' RuntimeIdentifier='$(RuntimeIdentifier)'</_AvaloniaAppHostInactive>
    </PropertyGroup>
    <!-- NativeAOT with the static graphics packages is a normal setup. -->
    <Warning Condition="'$(_AvaloniaAppHostInactiveReason)' == 'PublishAot' and '$(HostForgeStaticGraphicsImported)' != 'true'"
             Text="$(_AvaloniaAppHostInactive) because PublishAot is true. NativeAOT executables do not use the apphost templates, so the ANGLE, Skia and HarfBuzz dynamic libraries are published. ChsBuffer.SkiaSharp.Static and, on Windows, ChsBuffer.Angle.Static link them into NativeAOT executables." />
    <Warning Condition="'$(_AvaloniaAppHostInactiveReason)' == 'Language'"
             Text="$(_AvaloniaAppHostInactive) because the project language is $(Language). The executable resolves ANGLE, Skia and HarfBuzz through a C# module initializer, so only C# projects use the templates; this project publishes the dynamic libraries." />
    <Warning Condition="'$(_AvaloniaAppHostInactiveReason)' == 'NoTemplate'"
             Text="$(_AvaloniaAppHostInactive). No matching AvaloniaAppHostRids item for TFM '$(_AvaloniaTemplateTfm)' and RID '$(_AvaloniaTemplateRid)'. Registered: @(AvaloniaAppHostRids->'%(AppHostTemplateTfm)/%(Identity)', ', '). Host replacement and ANGLE/Skia/HarfBuzz runtime copy suppression are disabled." />
    <Warning Condition="'$(_AvaloniaAppHostInactiveReason)' == 'UseAppHost'"
             Text="$(_AvaloniaAppHostInactive) because UseAppHost is false. The application runs on dotnet, not on an apphost, so the ANGLE, Skia and HarfBuzz dynamic libraries are published." />
  </Target>

  <!--
    The templates link these libraries statically and resolve their DllImports from the main program.
    The symbol files belong to the packages' dynamic libraries and cannot symbolize the linked code.
    Single-file bundling and the publish directory copy both start from ResolvedFileToPublish after
    ComputeResolvedFilesToPublishList, so removing the libraries here keeps them out of both.
    The activation check is in the body because a target condition is evaluated before DependsOnTargets runs.
  -->
  <Target Name="RemovePrelinkedNativePublishItems"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="ResolveAvaloniaAppHostActivation">
    <ItemGroup Condition="'$(AvaloniaAppHostActive)' == 'true'">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == 'true' and $(_AvaloniaSkiaHarfBuzzNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'$(DisableAngleRuntimeCopy)' == 'true' and $(_AvaloniaAngleNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
    </ItemGroup>
  </Target>
</Project>
