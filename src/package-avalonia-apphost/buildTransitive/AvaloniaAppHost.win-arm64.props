<Project>
  <ItemGroup>
    <AvaloniaAppHostRids Include="win-arm64">
      <AppHostTemplateTfm>net10.0</AppHostTemplateTfm>
      <AppHostTemplatePath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'template/net10.0/win-arm64/apphost.exe'))</AppHostTemplatePath>
      <SingleFileHostTemplatePath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'template/net10.0/win-arm64/singlefilehost.exe'))</SingleFileHostTemplatePath>
    </AvaloniaAppHostRids>
  </ItemGroup>
</Project>
