<Project>
  <PropertyGroup>
    <DisableSkiaHarfBuzzRuntimeCopy Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == ''">true</DisableSkiaHarfBuzzRuntimeCopy>
  </PropertyGroup>

  <PropertyGroup>
    <_AvaloniaPackageRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))</_AvaloniaPackageRoot>
    <_AvaloniaModuleInitializer>$([MSBuild]::NormalizePath('$(_AvaloniaPackageRoot)', 'contentFiles/cs/net10.0/ModuleInitializer.cs'))</_AvaloniaModuleInitializer>
    <_AvaloniaSkiaNativeFileNames>;libSkiaSharp.dll;libSkiaSharp.so;</_AvaloniaSkiaNativeFileNames>
    <_AvaloniaHarfBuzzNativeFileNames>;libHarfBuzzSharp.dll;libHarfBuzzSharp.so;</_AvaloniaHarfBuzzNativeFileNames>
  </PropertyGroup>

  <Target Name="ResolveAvaloniaAppHostActivation"
          BeforeTargets="PrepareForBuild;_GetAppHostPaths">
    <PropertyGroup>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">$(TargetFramework)</_AvaloniaTemplateTfm>
      <_AvaloniaTemplateTfm Condition="'$(_AvaloniaTemplateTfm)' == ''">net10.0</_AvaloniaTemplateTfm>

      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(RuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(AppHostRuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">$(DefaultAppHostRuntimeIdentifier)</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRid Condition="'$(_AvaloniaTemplateRid)' == ''">win-x64</_AvaloniaTemplateRid>
      <_AvaloniaTemplateRidIsWindows Condition="'$(_AvaloniaTemplateRid)' != ''">$(_AvaloniaTemplateRid.StartsWith('win'))</_AvaloniaTemplateRidIsWindows>
      <_AvaloniaTemplateExecutableExtension Condition="'$(_AvaloniaTemplateRidIsWindows)' == 'True'">.exe</_AvaloniaTemplateExecutableExtension>
      <_AvaloniaTemplateExecutableExtension Condition="'$(_AvaloniaTemplateExecutableExtension)' == ''"></_AvaloniaTemplateExecutableExtension>

      <_AvaloniaAppHostPath>$([MSBuild]::NormalizePath('$(_AvaloniaPackageRoot)', 'template/$(_AvaloniaTemplateTfm)/$(_AvaloniaTemplateRid)/apphost$(_AvaloniaTemplateExecutableExtension)'))</_AvaloniaAppHostPath>
      <_AvaloniaSingleFileHostPath>$([MSBuild]::NormalizePath('$(_AvaloniaPackageRoot)', 'template/$(_AvaloniaTemplateTfm)/$(_AvaloniaTemplateRid)/singlefilehost$(_AvaloniaTemplateExecutableExtension)'))</_AvaloniaSingleFileHostPath>

      <AvaloniaAppHostActive Condition="'$(AvaloniaAppHostActive)' == '' and '$(TargetFramework)' != '' and Exists('$(_AvaloniaAppHostPath)') and Exists('$(_AvaloniaSingleFileHostPath)')">true</AvaloniaAppHostActive>
      <AvaloniaAppHostActive Condition="'$(AvaloniaAppHostActive)' == ''">false</AvaloniaAppHostActive>

      <AppHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(AppHostSourcePath)' == '' and Exists('$(_AvaloniaAppHostPath)')">$(_AvaloniaAppHostPath)</AppHostSourcePath>
      <SingleFileHostSourcePath Condition="'$(AvaloniaAppHostActive)' == 'true' and '$(SingleFileHostSourcePath)' == '' and Exists('$(_AvaloniaSingleFileHostPath)')">$(_AvaloniaSingleFileHostPath)</SingleFileHostSourcePath>
    </PropertyGroup>
  </Target>

  <Target Name="InjectAvaloniaModuleInitializer"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(AvaloniaAppHostActive)' == 'true' and Exists('$(_AvaloniaModuleInitializer)')">
    <ItemGroup>
      <Compile Include="$(_AvaloniaModuleInitializer)"
               Link="HostForge\Avalonia\ModuleInitializer.g.cs"
               Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="WarnAvaloniaAppHostInactive"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(TargetFramework)' != '' and '$(AvaloniaAppHostActive)' != 'true'">
    <Warning Text="ChsBuffer.Avalonia.AppHost is inactive for TargetFramework='$(TargetFramework)' RuntimeIdentifier='$(RuntimeIdentifier)'. Expected templates under 'template/$(_AvaloniaTemplateTfm)/$(_AvaloniaTemplateRid)' (or default net10.0/win-x64). Host replacement and Skia/HarfBuzz runtime copy suppression are disabled." />
  </Target>

  <Target Name="DisableSkiaHarfBuzzCopyLocalItems"
          AfterTargets="ResolveReferences"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == 'true' and '$(AvaloniaAppHostActive)' == 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension);'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension);'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
                             Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension);'))" />
    </ItemGroup>
  </Target>

  <Target Name="DisableSkiaHarfBuzzPublishItems"
          BeforeTargets="_CopyResolvedFilesToPublishPreserveNewest;_CopyResolvedFilesToPublishAlways"
          DependsOnTargets="ResolveAvaloniaAppHostActivation"
          Condition="'$(DisableSkiaHarfBuzzRuntimeCopy)' == 'true' and '$(AvaloniaAppHostActive)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension);'))" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)"
                                            Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(_ResolvedFileToPublishPreserveNewest.Filename)%(_ResolvedFileToPublishPreserveNewest.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(_ResolvedFileToPublishPreserveNewest.Filename)%(_ResolvedFileToPublishPreserveNewest.Extension);'))" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)"
                                    Condition="$(_AvaloniaSkiaNativeFileNames.Contains(';%(_ResolvedFileToPublishAlways.Filename)%(_ResolvedFileToPublishAlways.Extension);')) or $(_AvaloniaHarfBuzzNativeFileNames.Contains(';%(_ResolvedFileToPublishAlways.Filename)%(_ResolvedFileToPublishAlways.Extension);'))" />
    </ItemGroup>
  </Target>
</Project>
