<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.SkiaSharp.Static.win-x64</PackageId>
    <Version>$(SkiaSharpVersion)-alpha.1</Version>
    <Authors>ChsBuffer</Authors>
    <Description>SkiaSharp static library</Description>
    <PackageTags>skia;harfbuzz</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>

    <AvaloniaNativeLibsDir>$([MSBuild]::NormalizePath('$(AvaloniaNativeLibsRoot)', '$(AvaloniaHostRid)'))</AvaloniaNativeLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive/SkiaSharp.Static.props" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(AvaloniaNativeLibsDir)/**/*.lib"
      Pack="true"
      PackagePath="build/native/x64/%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
