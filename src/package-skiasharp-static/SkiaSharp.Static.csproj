<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <AvaloniaHostRid Condition="'$(AvaloniaHostRid)' == ''">win-x64</AvaloniaHostRid>
    <PackageId>ChsBuffer.SkiaSharp.Static.$(AvaloniaHostRid)</PackageId>
    <Version>$(SkiaSharpVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>SkiaSharp static library</Description>
    <PackageTags>skia;harfbuzz</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)\</PackageOutputPath>

    <AvaloniaNativeLibsDir>$([MSBuild]::NormalizePath('$(AvaloniaNativeLibsRoot)', '$(AvaloniaHostRid)'))</AvaloniaNativeLibsDir>
    <_SkiaLine>$([System.Text.RegularExpressions.Regex]::Match('$(SkiaSharpVersion)', '^\d+\.\d+'))</_SkiaLine>
    <_HarfBuzzLine>$([System.Text.RegularExpressions.Regex]::Match('$(HarfBuzzVersion)', '^\d+\.\d+\.\d+'))</_HarfBuzzLine>
    <_VersionProps>$(MSBuildProjectDirectory)/obj/$(PackageId).$(SkiaSharpVersion).Version.props</_VersionProps>
  </PropertyGroup>

  <Target Name="_ValidateAvaloniaHostRid">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(AvaloniaHostRid)', '^(win|linux|linux-musl|osx)-(x64|arm64)$'))"
           Text="AvaloniaHostRid='$(AvaloniaHostRid)' is not a supported 64-bit RID." />
  </Target>

  <ItemGroup>
    <None Include="buildTransitive/SkiaSharp.Static.props" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
    <None Include="buildTransitive/SkiaSharp.Static.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="../HostForge.StaticGraphics.targets" Pack="true" PackagePath="build/HostForge.StaticGraphics.targets" />
    <None Include="$(_VersionProps)" Pack="true" PackagePath="build/SkiaSharp.Version.props" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- LLVM 20.1.8 libc++ from the pinned Linux cross images. -->
    <None Include="licenses/libcxx.LICENSE.TXT" Pack="true" PackagePath="licenses/"
          Condition="$(AvaloniaHostRid.StartsWith('linux-')) and '$(_SkiaLine)' == '4.153'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(AvaloniaNativeLibsDir)/**/*" Pack="true"
      PackagePath="build/native/$(AvaloniaHostRid)/" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzVersion)" />
  </ItemGroup>

  <Target Name="_ValidateAvaloniaNativeLibsDir"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_ValidateAvaloniaHostRid">
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)')"
           Text="Avalonia native libs directory not found: $(AvaloniaNativeLibsDir)" />
    <Error Condition="!Exists('$(AvaloniaNativeLibsDir)/manifest.json')" Text="Static graphics manifest is missing." />
    <Error Condition="'$(HarfBuzzVersion)' == ''" Text="No HarfBuzzSharp mapping exists for $(SkiaSharpVersion)." />
    <!-- Freeze package identity in item metadata; properties are shared across RID imports. -->
    <PropertyGroup>
      <_PackageRegistration><![CDATA[
<Project>
  <ItemGroup>
    <HostForgeStaticPackage Include="SkiaSharp-$(AvaloniaHostRid)-$(_SkiaLine)">
      <Component>SkiaSharp</Component>
      <Rid>$(AvaloniaHostRid)</Rid>
      <SkiaLine>$(_SkiaLine)</SkiaLine>
      <HarfBuzzLine>$(_HarfBuzzLine)</HarfBuzzLine>
      <NativeDir>%24(MSBuildThisFileDirectory)native/$(AvaloniaHostRid)</NativeDir>
    </HostForgeStaticPackage>
  </ItemGroup>
</Project>
]]></_PackageRegistration>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionProps)" Overwrite="true" Lines="$(_PackageRegistration)" />
  </Target>

</Project>
