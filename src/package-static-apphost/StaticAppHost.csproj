<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.NETCore.StaticAppHost.win-x64</PackageId>
    <Version>$(StaticAppHostPackageVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Relink AppHost and SingleFileHost from NativeLibrary items with static host libs for win-x64.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>false</DevelopmentDependency>
    <StaticAppHostRid>win-x64</StaticAppHostRid>
    <PackageAssetsDir Condition="'$(PackageAssetsDir)' == ''">$(HostLibsRoot)\$(StaticAppHostRid)</PackageAssetsDir>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(StaticAppHostPackageOutputDir)\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\\ChsBuffer.NETCore.StaticAppHost.win-x64.targets" Pack="true" PackagePath="build/" />
    <None Include="build\\StaticAppHost.targets" Pack="true" PackagePath="build/" />
    <None Include="build\\findvcvarsall.bat" Pack="true" PackagePath="build/" />
    <None Include="$(PackageAssetsDir)\\**\\*" Pack="true" PackagePath="build/$(StaticAppHostRid)/" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="ValidatePackageAssetsDir" BeforeTargets="Pack">
    <Error Condition="!Exists('$(PackageAssetsDir)')" Text="Package assets directory not found: $(PackageAssetsDir)" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libapphost_obj.lib')" Text="Missing file: $(PackageAssetsDir)\\libapphost_obj.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libapphost_lib.lib')" Text="Missing file: $(PackageAssetsDir)\\libapphost_lib.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libapphost_directives.lib')" Text="Missing file: $(PackageAssetsDir)\\libapphost_directives.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libsinglefilehost_obj.lib')" Text="Missing file: $(PackageAssetsDir)\\libsinglefilehost_obj.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libsinglefilehost_lib.lib')" Text="Missing file: $(PackageAssetsDir)\\libsinglefilehost_lib.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\libsinglefilehost_directives.lib')" Text="Missing file: $(PackageAssetsDir)\\libsinglefilehost_directives.lib" />
    <Error Condition="!Exists('$(PackageAssetsDir)\\singlefilehost.def')" Text="Missing file: $(PackageAssetsDir)\\singlefilehost.def" />
  </Target>
</Project>
