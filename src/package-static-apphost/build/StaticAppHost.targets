<Project>
  <PropertyGroup>
    <CppLinker>link</CppLinker>
    <CppLibCreator>lib</CppLibCreator>
    <AppHostLinkPath Condition="'$(AppHostLinkPath)' == ''">$(IntermediateOutputPath)apphost.static.exe</AppHostLinkPath>
    <SingleFileHostLinkPath Condition="'$(SingleFileHostLinkPath)' == ''">$(IntermediateOutputPath)singlefilehost.static.exe</SingleFileHostLinkPath>
    <AppHostStampPath Condition="'$(AppHostStampPath)' == ''">$([System.IO.Path]::ChangeExtension('$(AppHostLinkPath)', '.inputs.stamp'))</AppHostStampPath>
    <SingleFileHostStampPath Condition="'$(SingleFileHostStampPath)' == ''">$([System.IO.Path]::ChangeExtension('$(SingleFileHostLinkPath)', '.inputs.stamp'))</SingleFileHostStampPath>
    <AppHostLinkFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AppHostLinkPath)'))</AppHostLinkFullPath>
    <SingleFileHostLinkFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(SingleFileHostLinkPath)'))</SingleFileHostLinkFullPath>
    <AppHostStampFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AppHostStampPath)'))</AppHostStampFullPath>
    <SingleFileHostStampFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(SingleFileHostStampPath)'))</SingleFileHostStampFullPath>

    <StaticHostRid Condition="'$(StaticHostRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</StaticHostRid>
    <StaticHostRid Condition="'$(StaticHostRid)' == '' and '$(AppHostRuntimeIdentifier)' != ''">$(AppHostRuntimeIdentifier)</StaticHostRid>
    <StaticHostRid Condition="'$(StaticHostRid)' == '' and '$(DefaultAppHostRuntimeIdentifier)' != ''">$(DefaultAppHostRuntimeIdentifier)</StaticHostRid>
    <_StaticHostRidSupported Condition="'$(StaticHostRid)' == 'win-x64'">true</_StaticHostRidSupported>

    <StaticHostLinkMachine Condition="'$(StaticHostLinkMachine)' == '' and '$(StaticHostRid)' == 'win-x64'">X64</StaticHostLinkMachine>
    <StaticHostVcVarsArch Condition="'$(StaticHostVcVarsArch)' == '' and '$(StaticHostRid)' == 'win-x64'">x64</StaticHostVcVarsArch>

    <StaticHostAssetsDir>$(MSBuildThisFileDirectory)$(StaticHostRid)</StaticHostAssetsDir>
    <_FindVcVarsAllPath>$(MSBuildThisFileDirectory)findvcvarsall.bat</_FindVcVarsAllPath>
    <AppHostLinkFlags>/DEPENDENTLOADFLAG:0x800 /DEBUG /DEBUGTYPE:CV,FIXUP /PDBCOMPRESS /STACK:0x180000 /MANIFEST:NO /CETCOMPAT /INCREMENTAL:NO /OPT:REF /OPT:ICF /NODEFAULTLIB:libucrt.lib /DEFAULTLIB:ucrt.lib /subsystem:console /guard:cf </AppHostLinkFlags>
    <SingleFileHostLinkFlags>/DEPENDENTLOADFLAG:0x800 /DEBUG /DEBUGTYPE:CV,FIXUP /PDBCOMPRESS /STACK:0x180000 /MANIFEST:NO /CETCOMPAT /INCREMENTAL:NO /DELAYLOAD:api-ms-win-core-winrt-l1-1-0.dll /DELAYLOAD:version.dll /OPT:REF /OPT:ICF /NODEFAULTLIB:libucrt.lib /DEFAULTLIB:ucrt.lib /subsystem:console /guard:cf </SingleFileHostLinkFlags>
  </PropertyGroup>

  <Target Name="_ResolveHostLinkInputs"
          Condition="'@(NativeLibrary)' != ''">
    <Error Condition="'$(_StaticHostRidSupported)' != 'true'"
           Text="RID '$(StaticHostRid)' is not supported by this package yet. Phase 1 supports win-x64 only." />
    <Error Condition="'$(StaticHostLinkMachine)' == ''"
           Text="Cannot infer linker machine from RID '$(StaticHostRid)'. Set StaticHostLinkMachine explicitly." />
    <Error Condition="'$(StaticHostVcVarsArch)' == ''"
           Text="Cannot infer vcvars architecture from RID '$(StaticHostRid)'. Set StaticHostVcVarsArch explicitly." />

    <ItemGroup>
      <_NativeLibraryInput Include="@(NativeLibrary)">
        <WholeArchive Condition="'%(NativeLibrary.WholeArchive)' == ''">false</WholeArchive>
      </_NativeLibraryInput>
    </ItemGroup>

    <Error Condition="'@(_NativeLibraryInput)' == ''"
           Text="No NativeLibrary items were provided." />
  </Target>

  <Target Name="_BuildCommonLinkerArgs"
          DependsOnTargets="_ResolveHostToolchain"
          Condition="'@(NativeLibrary)' != ''">
    <ItemGroup>
      <_CommonLinkerArg Include="/machine:$(StaticHostLinkMachine)" />
      <_CommonLinkerArg Include="@(AdditionalNativeLibraryDirectories->'/LIBPATH:&quot;%(Identity)&quot;')" />
      <_CommonLinkerArg Include="@(LinkerArg)" />
    </ItemGroup>
  </Target>

  <Target Name="_GenerateAppHostFingerprint"
          DependsOnTargets="_ResolveHostToolchain"
          Condition="'@(NativeLibrary)' != '' and ('$(ComputeNETCoreBuildOutputFiles)' == 'true' or '$(_UpdateAppHostForPublish)' == 'true')">
    <ItemGroup>
      <_AppHostFingerprintInput Include="$(StaticHostAssetsDir)\\libapphost_obj.lib" />
      <_AppHostFingerprintInput Include="$(StaticHostAssetsDir)\\libapphost_lib.lib" />
      <_AppHostFingerprintInput Include="$(StaticHostAssetsDir)\\libapphost_directives.lib" />
    </ItemGroup>

    <PropertyGroup>
      <_NativeLibraryInputFingerprint>@(_NativeLibraryInput->'%(FullPath)|%(ModifiedTime)|%(Length)|%(WholeArchive)', '&#x0A;')</_NativeLibraryInputFingerprint>
      <_AppHostAssetFingerprint>@(_AppHostFingerprintInput->'%(FullPath)|%(ModifiedTime)|%(Length)', '&#x0A;')</_AppHostAssetFingerprint>
      <_ToolchainFingerprint>CppLinker=$(CppLinker)&#x0A;AdditionalNativeLibraryDirectories=@(AdditionalNativeLibraryDirectories, ';')</_ToolchainFingerprint>
      <_UserLinkerArgFingerprint>@(LinkerArg, '&#x0A;')</_UserLinkerArgFingerprint>
      <_AppHostFingerprint>NativeLibrary&#x0A;$(_NativeLibraryInputFingerprint)&#x0A;HostAssets&#x0A;$(_AppHostAssetFingerprint)&#x0A;$(_ToolchainFingerprint)&#x0A;UserLinkerArg&#x0A;$(_UserLinkerArgFingerprint)&#x0A;LinkFlags=$(AppHostLinkFlags)</_AppHostFingerprint>
    </PropertyGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(AppHostStampFullPath)'))" />
    <WriteLinesToFile File="$(AppHostStampFullPath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="Rid=$(StaticHostRid)&#x0A;Machine=$(StaticHostLinkMachine)&#x0A;VcVarsArch=$(StaticHostVcVarsArch)&#x0A;$(_AppHostFingerprint)" />
  </Target>

  <Target Name="LinkAppHost"
          BeforeTargets="_CreateAppHost;_CreateAppHostForPublish"
          DependsOnTargets="_GenerateAppHostFingerprint;_BuildCommonLinkerArgs"
          Inputs="$(AppHostStampFullPath)"
          Outputs="$(AppHostLinkFullPath)"
          Condition="'@(NativeLibrary)' != '' and ('$(ComputeNETCoreBuildOutputFiles)' == 'true' or '$(_UpdateAppHostForPublish)' == 'true')">
    <ItemGroup>
      <_AppHostWholeArchiveNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' == 'true'" />
      <_AppHostDefaultNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' != 'true'" />
      <_AppHostLinkerArg Include="@(_CommonLinkerArg)" />
      <_AppHostLinkerArg Include="$(AppHostLinkFlags)" />
      <_AppHostLinkerArg Include="/wholearchive:&quot;$(StaticHostAssetsDir)\\libapphost_obj.lib&quot;" />
      <_AppHostLinkerArg Include="@(_AppHostWholeArchiveNativeLib->'/wholearchive:&quot;%(FullPath)&quot;')" />
      <_AppHostLinkerArg Include="@(_AppHostDefaultNativeLib->'&quot;%(FullPath)&quot;')" />
      <_AppHostLinkerArg Include="/wholearchive:&quot;$(StaticHostAssetsDir)\\libapphost_directives.lib&quot;" />
      <_AppHostLinkerArg Include="&quot;$(StaticHostAssetsDir)\\libapphost_lib.lib&quot;" />
      <_AppHostLinkerArg Include="/out:&quot;$(AppHostLinkFullPath)&quot;" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(AppHostLinkFullPath)'))" />
    <Exec Command="&quot;$(CppLinker)&quot; @(_AppHostLinkerArg, ' ')" />

    <PropertyGroup>
      <AppHostSourcePath>$(AppHostLinkFullPath)</AppHostSourcePath>
    </PropertyGroup>
  </Target>

  <Target Name="_GenerateSingleFileHostFingerprint"
          DependsOnTargets="_ResolveHostToolchain"
          Condition="'@(NativeLibrary)' != '' and '$(_UseSingleFileHostForPublish)' == 'true'">
    <ItemGroup>
      <_SingleFileHostFingerprintInput Include="$(StaticHostAssetsDir)\\singlefilehost.def" />
      <_SingleFileHostFingerprintInput Include="$(StaticHostAssetsDir)\\libsinglefilehost_obj.lib" />
      <_SingleFileHostFingerprintInput Include="$(StaticHostAssetsDir)\\libsinglefilehost_lib.lib" />
      <_SingleFileHostFingerprintInput Include="$(StaticHostAssetsDir)\\libsinglefilehost_directives.lib" />
    </ItemGroup>

    <PropertyGroup>
      <_NativeLibraryInputFingerprint>@(_NativeLibraryInput->'%(FullPath)|%(ModifiedTime)|%(Length)|%(WholeArchive)', '&#x0A;')</_NativeLibraryInputFingerprint>
      <_SingleFileHostAssetFingerprint>@(_SingleFileHostFingerprintInput->'%(FullPath)|%(ModifiedTime)|%(Length)', '&#x0A;')</_SingleFileHostAssetFingerprint>
      <_ToolchainFingerprint>CppLinker=$(CppLinker)&#x0A;AdditionalNativeLibraryDirectories=@(AdditionalNativeLibraryDirectories, ';')</_ToolchainFingerprint>
      <_UserLinkerArgFingerprint>@(LinkerArg, '&#x0A;')</_UserLinkerArgFingerprint>
      <_SingleFileHostFingerprint>NativeLibrary&#x0A;$(_NativeLibraryInputFingerprint)&#x0A;HostAssets&#x0A;$(_SingleFileHostAssetFingerprint)&#x0A;$(_ToolchainFingerprint)&#x0A;UserLinkerArg&#x0A;$(_UserLinkerArgFingerprint)&#x0A;LinkFlags=$(SingleFileHostLinkFlags)</_SingleFileHostFingerprint>
    </PropertyGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SingleFileHostStampFullPath)'))" />
    <WriteLinesToFile File="$(SingleFileHostStampFullPath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="Rid=$(StaticHostRid)&#x0A;Machine=$(StaticHostLinkMachine)&#x0A;VcVarsArch=$(StaticHostVcVarsArch)&#x0A;$(_SingleFileHostFingerprint)" />
  </Target>

  <Target Name="LinkSingleFileHost"
          BeforeTargets="_CreateSingleFileHost"
          DependsOnTargets="_GenerateSingleFileHostFingerprint;_BuildCommonLinkerArgs"
          Inputs="$(SingleFileHostStampFullPath)"
          Outputs="$(SingleFileHostLinkFullPath)"
          Condition="'@(NativeLibrary)' != '' and '$(_UseSingleFileHostForPublish)' == 'true'">
    <ItemGroup>
      <_SingleFileWholeArchiveNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' == 'true'" />
      <_SingleFileDefaultNativeLib Include="@(_NativeLibraryInput)" Condition="'%(WholeArchive)' != 'true'" />
      <_SingleFileHostLinkerArg Include="@(_CommonLinkerArg)" />
      <_SingleFileHostLinkerArg Include="$(SingleFileHostLinkFlags)" />
      <_SingleFileHostLinkerArg Include="/DEF:&quot;$(StaticHostAssetsDir)\\singlefilehost.def&quot;" />
      <_SingleFileHostLinkerArg Include="/wholearchive:&quot;$(StaticHostAssetsDir)\\libsinglefilehost_obj.lib&quot;" />
      <_SingleFileHostLinkerArg Include="@(_SingleFileWholeArchiveNativeLib->'/wholearchive:&quot;%(FullPath)&quot;')" />
      <_SingleFileHostLinkerArg Include="@(_SingleFileDefaultNativeLib->'&quot;%(FullPath)&quot;')" />
      <_SingleFileHostLinkerArg Include="/wholearchive:&quot;$(StaticHostAssetsDir)\\libsinglefilehost_directives.lib&quot;" />
      <_SingleFileHostLinkerArg Include="&quot;$(StaticHostAssetsDir)\\libsinglefilehost_lib.lib&quot;" />
      <_SingleFileHostLinkerArg Include="/out:&quot;$(SingleFileHostLinkFullPath)&quot;" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SingleFileHostLinkFullPath)'))" />
    <Exec Command="&quot;$(CppLinker)&quot; @(_SingleFileHostLinkerArg, ' ')" />

    <PropertyGroup>
      <SingleFileHostSourcePath>$(SingleFileHostLinkFullPath)</SingleFileHostSourcePath>
    </PropertyGroup>
  </Target>

  <Target Name="_ResolveHostToolchain"
          DependsOnTargets="_ResolveHostLinkInputs"
          Condition="'@(NativeLibrary)' != ''">
    <Exec Command="&quot;$(_FindVcVarsAllPath)&quot; $(StaticHostVcVarsArch)"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FindVCVarsallOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_VCVarsAllFound" />
    </Exec>

    <ItemGroup Condition="'$(_VCVarsAllFound)' == '0'">
      <AdditionalNativeLibraryDirectories Include="$(_FindVCVarsallOutput.Split(`#`)[1].Split(';'))" />
    </ItemGroup>

    <PropertyGroup Condition="'$(_VCVarsAllFound)' == '0'">
      <_CppToolsDirectory>$(_FindVCVarsallOutput.Split(`#`)[0])</_CppToolsDirectory>
      <CppLinker>$(_CppToolsDirectory)link.exe</CppLinker>
      <CppLibCreator>$(_CppToolsDirectory)lib.exe</CppLibCreator>
    </PropertyGroup>

    <Error Condition="'$(_VCVarsAllFound)' == '1'"
           Text="[StaticAppHost] MSVC toolchain not found. Install Desktop development with C++ workload (and ARM64 build tools when needed)." />
  </Target>
</Project>

