<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/$(StaticGraphicsComponent)/$(SkiaSharpVersion)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <PackageId>ChsBuffer.$(StaticGraphicsComponent).Static</PackageId>
    <_NativeVersion Condition="'$(StaticGraphicsComponent)' == 'SkiaSharp'">$(SkiaSharpVersion)</_NativeVersion>
    <_NativeVersion Condition="'$(StaticGraphicsComponent)' == 'Angle'">$(AngleVersion)</_NativeVersion>
    <AvaloniaNativeVersion Condition="'$(AvaloniaNativeVersion)' == ''">12.1.3</AvaloniaNativeVersion>
    <_NativeVersion Condition="'$(StaticGraphicsComponent)' == 'Avalonia.Native'">$(AvaloniaNativeVersion)</_NativeVersion>
    <PackagingRevision Condition="'$(PackagingRevision)' == ''">0</PackagingRevision>
    <_NativeVersion Condition="'$(PackagingRevision)' != '0'">$(_NativeVersion).$(PackagingRevision)</_NativeVersion>
    <Version>$(_NativeVersion)</Version>
    <Authors>ChsBuffer</Authors>
    <Description>Static $(StaticGraphicsComponent) libraries for NativeAOT on all supported RIDs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chsbuffer/HostForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsbuffer/HostForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackageOutputPath>$(AvaloniaAppHostPackageOutputDir)</PackageOutputPath>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(AvaloniaAppHostPackageOutputDir)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <_StaticGraphicsRid Include="win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64" Condition="'$(StaticGraphicsComponent)' == 'SkiaSharp'" />
    <_StaticGraphicsRid Include="win-x64;win-arm64" Condition="'$(StaticGraphicsComponent)' == 'Angle'" />
    <_StaticGraphicsRid Include="osx-x64;osx-arm64" Condition="'$(StaticGraphicsComponent)' == 'Avalonia.Native'" />
    <PackageReference Include="@(_StaticGraphicsRid->'ChsBuffer.$(StaticGraphicsComponent).Static.%(Identity)')" Version="[$(_NativeVersion)]" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="ValidateStaticGraphicsComponent" BeforeTargets="CollectPackageReferences;_GetPackageFiles">
    <Error Condition="'$(_NativeVersion)' == ''" Text="StaticGraphicsComponent must be SkiaSharp, Angle or Avalonia.Native." />
  </Target>
</Project>
