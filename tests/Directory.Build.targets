<Project>
  <PropertyGroup>
    <!-- One exact TUnit version for every test project; MSBuild evaluates this before the projects' PackageReference items. -->
    <TUnitVersion>1.87.12</TUnitVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)' == 'Exe'">
    <RuntimeHostConfigurationOption Include="HostForgeRepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>
</Project>
