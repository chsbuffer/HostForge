<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <UseAvaloniaNativeStatic Condition="'$(UseAvaloniaNativeStatic)' == ''">true</UseAvaloniaNativeStatic>
    <StripSymbols>false</StripSymbols>
    <SmokeAvaloniaVersion Condition="'$(SmokeAvaloniaVersion)' == ''">12.1.3</SmokeAvaloniaVersion>
    <AvaloniaNativePackageVersion Condition="'$(AvaloniaNativePackageVersion)' == ''">12.1.3</AvaloniaNativePackageVersion>
    <RestoreAdditionalProjectSources Condition="'$(UseAvaloniaNativeStatic)' == 'true'">$(RestoreAdditionalProjectSources);$(AvaloniaAppHostPackageOutputDir)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(SmokeAvaloniaVersion)" />
    <PackageReference Include="ChsBuffer.Avalonia.Native.Static.$(RuntimeIdentifier)" Version="$(AvaloniaNativePackageVersion)" Condition="'$(UseAvaloniaNativeStatic)' == 'true'" />
    <PackageReference Include="ChsBuffer.SkiaSharp.Static.$(RuntimeIdentifier)" Version="$(SmokeStaticSkiaVersion)" Condition="'$(SmokeStaticSkiaVersion)' != ''" />
  </ItemGroup>
</Project>
